#!/usr/bin/env python3
"""Run by pre-push with git's pre-push input on stdin: each pushed commit no remote-tracking ref holds yet that changes
skills/ or always-on.md needs a `Cold-read: <path>` trailer naming an existing file (the cold read's record, rules step 4),
in it or a later commit of the push. A published commit, such as main's squash merge of a checked PR, isn't checked again.
`cold-read <base>..<head>`, for pr-steps small's docs-only diff: exits 0 when some commit of the range has such a trailer."""
import os, subprocess, sys

ZERO = '0' * 40
git = lambda *a: subprocess.run(['git', *a], capture_output=True, text=True, check=True).stdout
cold_read = lambda c: any(os.path.isfile(os.path.expanduser(p.strip()))
                          for p in git('log', '-1', '--format=%(trailers:key=Cold-read,valueonly)', c).splitlines() if p.strip())
if sys.argv[1:]:
    sys.exit(not any(map(cold_read, git('rev-list', sys.argv[1]).split())))
missing = []
for line in sys.stdin:
    _, local, _, remote = line.split()
    if local == ZERO:
        continue  # a deleted ref pushes no commits
    commits = git('rev-list', '--reverse', local, '--not', '--remotes', *([] if remote == ZERO else [remote])).split()
    read = [cold_read(c) for c in commits]
    for i, c in enumerate(commits):
        files = git('diff-tree', '--no-commit-id', '--name-only', '-r', c).split()
        if any(f.startswith('skills/') or f == 'always-on.md' for f in files) and not any(read[i:]):
            missing.append(git('log', '-1', '--format=%h %s', c).strip())
if missing:
    print("pre-push: these commits change a skill or always-on.md, and no commit of the push from them on has a "
          "`Cold-read: <path>` trailer naming the cold read's record (mergeworthy:rules step 4):\n" + '\n'.join(missing))
    sys.exit(1)
