#!/bin/bash
# gh-watch-start [--main] <dir> [owner/repo [N|all]]...: the one way to start watching (mergeworthy:task step 5). Idempotent.
# - --main: this dir gets your /ai calls, and /agent calls no dir claims, on threads no watcher watches (default: the first live dir).
# - <dir> is the session's work folder; it gets links to the daemon (../watcher/), threads.txt and repos.txt.
# - "owner/repo N" goes to threads.txt; a bare "owner/repo" goes to repos.txt (the repo is covered, e.g. before `gh issue create`);
#   "owner/repo all" too: the whole repo is watched (gh-watch.py's moved_thread).
#   GitLab: "gitlab.com/<namespace>/<project>" with N for an issue, !N for a merge request.
# - Starts the daemon unless its PID is alive, with GH_WATCH_EYES from the environment, else from <dir>/eyes, else your gh login.
# - A thread line drops its repo's bare line (not an `all` line) from repos.txt; <dir>/session records the Claude session that ran it.
# - Registers <dir> in ~/.claude/gh-watch-dirs.txt, which pre-bash-guard and post-bash-register read.
# - Removes <dir>/retired, which the watcher writes when it retires (disk-sweep's w-done rule).
# - Prints the Monitor to arm in the session: the daemon only records events in <dir>/events.log; the session that
#   owns the threads is the one that answers them, woken by that Monitor (mergeworthy:reply).
# - --pass: no daemon: one round of the watcher appends to events.log, recording what it reported, and touches <dir>/passed
#   (mergeworthy:steward); a thread another live dir watches is skipped with a note. Refused while the dir's daemon runs.
set -e
main=; [ "${1:-}" = --main ] && { main=1; shift; }
pass=; [ "${1:-}" = --pass ] && { pass=1; shift; }
[ -n "$1" ] || { sed -n '2,10p' "$0"; exit 1; }
dir=$(realpath -m "$1"); shift
[ -n "$main" ] && { mkdir -p ~/.mergeworthy; echo "$dir" > ~/.mergeworthy/main-watch; }
# link through the stable path when installed as a plugin (its own folder changes with every update), even when this
# copy is an older version on a session's PATH: a watcher linked to a version folder never moved to the next one
root=$(dirname "$(dirname "$(realpath "$0")")"); case "$root" in */plugins/cache/*) [ -d ~/.mergeworthy/current ] && root=~/.mergeworthy/current;; esac
mkdir -p "$dir"; touch "$dir/threads.txt" "$dir/repos.txt" "$dir/events.log"
for f in gh-watch.py gh-watch-daemon.sh; do ln -sfn "$root/watcher/$f" "$dir/$f"; done
while [ $# -gt 0 ]; do
  repo=$1; shift
  [[ $repo == */* ]] || { echo "not owner/repo: $repo"; exit 1; }
  if [[ ${1:-} =~ ^[0-9]+$ || ( $repo == gitlab.com/* && ${1:-} =~ ^![0-9]+$ ) ]]; then line="$repo $1"; file=threads.txt; shift
  elif [ "${1:-}" = all ]; then line="$repo all"; file=repos.txt; shift; else line=$repo; file=repos.txt; fi
  # One watcher per thread: a second would report the same comment to a second session
  if [ "$file" = threads.txt ]; then
    taken=
    while read -r other; do
      [ "$other" != "$dir" ] && [ -f "$other/threads.txt" ] && grep -qxF "$line" "$other/threads.txt" || continue
      opid=$(cat "$other/gh-watch.pid" 2>/dev/null || true)
      if [ -n "$opid" ] && ps -p "$opid" -o command= 2>/dev/null | grep -q gh-watch-daemon; then taken=$other; fi
    done < <(cat ~/.claude/gh-watch-dirs.txt 2>/dev/null)
    if [ -n "$taken" ] && [ -n "$pass" ]; then echo "skipped $line: $taken watches it" >&2; continue; fi
    [ -z "$taken" ] || { echo "$line is already watched by $taken: use that work folder, or remove the line there first" >&2; exit 1; }
  fi
  grep -qxF "$line" "$dir/$file" || echo "$line" >> "$dir/$file"
  # the thread covers its repo now: its bare repo line says nothing more
  if [ "$file" = threads.txt ]; then grep -vxF "$repo" "$dir/repos.txt" > "$dir/repos.txt.tmp" || true; mv "$dir/repos.txt.tmp" "$dir/repos.txt"; fi
done
# the session that started it owns it: post-bash-register adds that session's new threads here (cron's revival has no session)
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then echo "$CLAUDE_CODE_SESSION_ID" > "$dir/session"; fi
reg=~/.claude/gh-watch-dirs.txt
grep -qxF "$dir" "$reg" 2>/dev/null || echo "$dir" >> "$reg"
if [ -n "$GH_WATCH_EYES" ]; then echo "$GH_WATCH_EYES" > "$dir/eyes"; fi
# gh prints an error answer (a rate limit) on stdout too: keep only a login gh really returned
if ! [ -s "$dir/eyes" ]; then
  if login=$(gh api user --jq .login 2>/dev/null) && [ -n "$login" ]; then echo "$login" > "$dir/eyes"; else echo "gh-watch-start: could not read your login (gh api user failed); no maintainers watched until you re-run it" >&2; fi
fi
# Supervision, so the watcher restarts on failure and after a reboot, with no session alive:
# systemd user service (Linux), launchd agent (macOS), else a detached daemon that cron revives.
printf 'PATH=%s\nHOME=%s\n' "$PATH" "$HOME" > "$dir/env"
daemon_alive() { local p; p=$(cat "$dir/gh-watch.pid" 2>/dev/null || true); [ -n "$p" ] && ps -p "$p" -o command= 2>/dev/null | grep -q gh-watch-daemon; }
if [ -n "$pass" ]; then
  daemon_alive && { echo "a daemon watches $dir: read its events.log past events.cursor instead" >&2; exit 1; }
  n=$(wc -l < "$dir/events.log")
  (cd "$dir" && GH_WATCH_EYES=$(cat eyes 2>/dev/null) python3 -u gh-watch.py --pass >> events.log 2>&1) || echo "WATCH ERROR gh-watch.py --pass exited $?" >> "$dir/events.log"
  touch "$dir/passed"; rm -f "$dir/retired"
  echo "pass: $(( $(wc -l < "$dir/events.log") - n )) new lines in $dir/events.log; read it past events.cursor (mergeworthy:reply)"
  exit 0
fi
if [ "$(uname)" = Linux ] && systemctl --user show-environment >/dev/null 2>&1; then
  unit=~/.config/systemd/user/gh-watch@.service
  mkdir -p "$(dirname "$unit")"
  cat > "$unit.new" <<'UNIT'
[Unit]
Description=GitHub watcher for /%I
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/%I
EnvironmentFile=/%I/env
Environment=GH_WATCH_SUPERVISOR=systemd
ExecStart=/bin/bash -c 'GH_WATCH_EYES=$(cat eyes) exec ./gh-watch-daemon.sh'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
UNIT
  if cmp -s "$unit.new" "$unit"; then rm "$unit.new"; else mv "$unit.new" "$unit"; systemctl --user daemon-reload; fi
  inst="gh-watch@$(systemd-escape --path "$dir").service"
  # a detached daemon from an older start: the service replaces it
  if ! systemctl --user is-active --quiet "$inst" && daemon_alive; then kill "$(cat "$dir/gh-watch.pid")"; sleep 1; fi
  systemctl --user enable --now "$inst" >/dev/null 2>&1
  loginctl show-user "$USER" 2>/dev/null | grep -q '^Linger=yes' || echo "note: without 'loginctl enable-linger $USER' the service starts at login, not at boot" >&2
  sleep 1; echo "watcher: systemd service $inst $(systemctl --user is-active "$inst") (PID $(cat "$dir/gh-watch.pid" 2>/dev/null), eyes: $(cat "$dir/eyes"))"
elif [ "$(uname)" = Darwin ]; then
  label="com.methodology.gh-watch.$(printf %s "$dir" | shasum | cut -c1-12)"
  plist=~/Library/LaunchAgents/$label.plist
  mkdir -p ~/Library/LaunchAgents
  cat > "$plist.new" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>WorkingDirectory</key><string>$dir</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>-c</string><string>GH_WATCH_EYES=\$(cat eyes) exec ./gh-watch-daemon.sh</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$PATH</string><key>HOME</key><string>$HOME</string><key>GH_WATCH_SUPERVISOR</key><string>launchd</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict></plist>
PLIST
  if ! cmp -s "$plist.new" "$plist"; then
    mv "$plist.new" "$plist"; launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
  else rm "$plist.new"; fi
  if ! launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
    daemon_alive && { kill "$(cat "$dir/gh-watch.pid")"; sleep 1; }
    launchctl bootstrap "gui/$(id -u)" "$plist"
  fi
  sleep 1; echo "watcher: launchd agent $label (PID $(cat "$dir/gh-watch.pid" 2>/dev/null), eyes: $(cat "$dir/eyes"))"
else
  if ! daemon_alive; then
    # fully detached: with `nohup setsid … &` the daemon stayed this script's child and the script never returned
    if command -v setsid >/dev/null; then (cd "$dir" && GH_WATCH_EYES=$(cat eyes) setsid -f ./gh-watch-daemon.sh </dev/null >/dev/null 2>&1)
    else (cd "$dir" && GH_WATCH_EYES=$(cat eyes) nohup ./gh-watch-daemon.sh </dev/null >/dev/null 2>&1 & disown); fi
    sleep 1
  fi
  # cron revives it after a crash or a reboot (gh-watch-start is idempotent)
  if command -v crontab >/dev/null; then
    job="*/5 * * * * \"$root/bin/gh-watch-start\" \"$dir\" >/dev/null 2>&1 # gh-watch $dir"
    # `|| true`: grep finds nothing to keep in an empty crontab, and set -e would then install an empty one
    { crontab -l 2>/dev/null | grep -vF "# gh-watch $dir" || true; echo "$job"; echo "@reboot \"$root/bin/gh-watch-start\" \"$dir\" >/dev/null 2>&1 # gh-watch $dir"; } | crontab -
  else
    echo "note: no systemd, launchd or cron: the watcher won't restart after a reboot" >&2
  fi
  echo "watcher: daemon PID $(cat "$dir/gh-watch.pid"), revived by cron (eyes: $(cat "$dir/eyes"))"
fi
rm -f "$dir/agent" "$dir/wake.pid" "$dir/wake.launch"  # from the watcher that started a headless agent per event
rm -f "$dir/retired"  # a re-armed dir is not finished: disk-sweep's w-done deletes only a dir its watcher retired
echo "Arm a Monitor in this session on (max timeout; re-arm it when it expires, since the expiry notice wakes the session):"
# a shell loop, not grep or awk: an agent shell's grep can be a wrapper, and mawk, that hold matched lines back
echo "  tail -n 0 -F $dir/events.log 2>/dev/null | while IFS= read -r l; do case \$l in '###'*|'WATCH ERROR'*|'WATCHER RETIRED'*) printf '%s\\n' \"\$l\";; esac; done"
