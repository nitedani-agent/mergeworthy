#!/usr/bin/env python3
"""state-reconcile <artifact root>: checks <root>/state.md (core 1.2) against ground truth and lists every drift: a
worktree's head or branch, the pushed head (ls-remote), the PR's state and head, a missing evidence file, a worktree of a
listed repo no block names, a report newer than the file it doesn't name, and the user's messages since the last run
(from the transcripts that name the root). Writes the list to <root>/state-reconcile.md too; exits 1 when anything drifted."""
import glob, json, os, re, subprocess, sys, time
from datetime import datetime
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'hooks'))
import state_file

if len(sys.argv) != 2:
    sys.exit('usage: state-reconcile <artifact root>')
root = os.path.abspath(os.path.expanduser(sys.argv[1]))
state = os.path.join(root, 'state.md')
if not os.path.isfile(state):
    sys.exit(f'state-reconcile: no {state}; write it in the shape core 1.2 gives')
text = open(state, errors='replace').read()
drift, user = [], []

def run(*cmd, cwd=None):
    r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None

def same(a, b):
    return bool(a and b) and (a.startswith(b) or b.startswith(a))

def local(ts):  # every time with its offset: a local time read as UTC is off by the offset
    return datetime.fromtimestamp(ts).astimezone().isoformat(timespec='minutes')

for h in ('Goal', 'Critical path', 'Workstreams', 'Decisions', 'Lessons'):
    if not re.search(r'^## ' + h, text, re.M):
        drift.append(f'state.md: no `## {h}` section')
ws = state_file.workstreams(state)
named_worktrees, repos = set(), {}
for name, b in ws.items():
    f = lambda k: state_file.field(b, k)
    status, wt, branch, head, pr = f('status'), os.path.expanduser(f('worktree')), f('branch'), f('head'), f('PR')
    closed = re.match(r'(done|merged|superseded|dead)\b', status, re.I)
    if not status:
        drift.append(f'{name}: no status')
    m = re.match(r'superseded\b\W*(?:by\s+)?(.*)', status, re.I)
    if m and m.group(1).strip() not in ws:
        drift.append(f'{name}: SUPERSEDED names no workstream that replaced it ({m.group(1).strip() or "none"})')
    if wt:
        named_worktrees.add(os.path.realpath(wt))
        if not os.path.isdir(wt):
            if not closed:
                drift.append(f'{name}: worktree {wt} is gone')
        else:
            common = run('git', 'rev-parse', '--path-format=absolute', '--git-common-dir', cwd=wt)
            if common:
                repos[common] = wt
            real = run('git', 'rev-parse', 'HEAD', cwd=wt)
            if head and not same(real, head):
                drift.append(f'{name}: worktree head is {real[:10] if real else "unreadable"}, state.md says {head}')
            cur = run('git', 'branch', '--show-current', cwd=wt)
            if branch and cur is not None and cur != branch:
                drift.append(f'{name}: worktree is on {cur or "a detached HEAD"}, state.md says {branch}')
            if branch:
                remote = (run('git', 'ls-remote', 'origin', 'refs/heads/' + branch, cwd=wt) or '').split('\t')[0]
                pushed = f('pushed').lower()
                if pushed.startswith('yes') and not same(remote, head):
                    drift.append(f'{name}: state.md says pushed, origin/{branch} is {remote[:10] or "absent"}')
                if pushed.startswith('no') and remote and same(remote, head):
                    drift.append(f'{name}: state.md says not pushed, origin/{branch} has {head}')
    m = re.search(r'([\w.-]+/[\w.-]+)#(\d+)', pr)
    if m:
        out = run('gh', 'api', f'repos/{m.group(1)}/pulls/{m.group(2)}')
        if out is None:
            drift.append(f'{name}: {pr} unreadable through gh')
        else:
            p = json.loads(out)
            st = 'merged' if p.get('merged') else p.get('state', '')
            if st != 'open' and not closed:
                drift.append(f'{name}: {pr} is {st}, status is still `{status}`')
            if st == 'open' and closed:
                drift.append(f'{name}: {pr} is still open, status is `{status}`')
            if st == 'open' and head and not same(p.get('head', {}).get('sha', ''), head):
                drift.append(f"{name}: {pr} head is {p.get('head', {}).get('sha', '')[:10]}, state.md says {head}")
    ev = os.path.expanduser(f('evidence'))
    if ev and ev.startswith('/') and not os.path.exists(ev):
        drift.append(f'{name}: evidence {ev} is missing')

for common, wt in repos.items():
    for blk in (run('git', 'worktree', 'list', '--porcelain', cwd=wt) or '').split('\n\n')[1:]:
        path = blk.split('\n', 1)[0].removeprefix('worktree ')
        if path and os.path.realpath(path) not in named_worktrees:
            br = re.search(r'^branch refs/heads/(.*)$', blk, re.M)
            drift.append(f"worktree {path} ({br.group(1) if br else 'detached'}) of {os.path.dirname(common)} is in no workstream")

mtime = os.path.getmtime(state)
for p in glob.glob(os.path.join(root, '*.md')) + glob.glob(os.path.join(root, '*', '*.md')):
    rel = os.path.relpath(p, root)
    if (rel not in ('state.md', 'state-reconcile.md') and not rel.startswith('drafts' + os.sep)
            and os.path.getmtime(p) > mtime and rel not in text and p not in text):
        drift.append(f'{rel} ({local(os.path.getmtime(p))}) is newer than state.md and not in it: fold its result in')

last_f = os.path.join(root, 'state-reconcile.last')
since = float(open(last_f).read().strip() or 0) if os.path.exists(last_f) else mtime
home_root = root.replace(os.path.expanduser('~'), '~', 1)
for tp in glob.glob(os.path.expanduser('~/.claude/projects/*/*.jsonl')):
    if os.path.getmtime(tp) < since:
        continue
    lines = open(tp, errors='replace').read().splitlines()
    if not any(root in l or home_root in l for l in lines):
        continue
    for l in lines:
        try: e = json.loads(l)
        except ValueError: continue
        c = (e.get('message') or {}).get('content')
        if e.get('type') != 'user' or e.get('isMeta') or e.get('isCompactSummary') or not isinstance(c, str) or c.startswith('<'):
            continue
        try: ts = datetime.fromisoformat(e.get('timestamp', '').replace('Z', '+00:00')).timestamp()
        except ValueError: continue
        if ts > since:
            user.append((ts, ' '.join(c.split())[:400]))

out = [f'# state-reconcile {local(time.time())}', '', f'{len(drift)} drift' + (':' if drift else ' items.')]
out += [f'- {x}' for x in drift]
if user:
    out += ['', f'User messages since {local(since)}: fold each ruling, decision and ask into state.md:']
    out += [f'- {local(ts)}: {c}' for ts, c in sorted(set(user))]
report = '\n'.join(out) + '\n'
open(os.path.join(root, 'state-reconcile.md'), 'w').write(report)
open(last_f, 'w').write(str(time.time()))
print(report, end='')
sys.exit(1 if drift else 0)
