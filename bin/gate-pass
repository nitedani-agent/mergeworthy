#!/bin/bash
# gate-pass <draft.md> <review-output-file> [post-lint flags]: records that <draft.md> passed the posting gate.
# Requires post-lint to pass, a current thread-context.md next to a reply/inline/proposal draft, and the review's final message to be exactly CLEAN (the reviewer writes only its verdict to that file).
# Writes <draft.md>.gate with the draft's sha256; the posting hook checks it, so any later edit needs a new review.
set -e
d="$1"; r="$2"
[ -f "$d" ] && [ -f "$r" ] || { echo "usage: gate-pass <draft.md> <review-output> [post-lint flags]"; exit 2; }
# the flags given here, else those the draft last passed post-lint with (<draft>.lint), else a reply's
shift 2; flags=("$@"); [ ${#flags[@]} -gt 0 ] || { [ -f "$d.lint" ] && read -ra flags < "$d.lint"; } || true
"$(dirname "$(readlink -f "$0")")/post-lint" "$d" "${flags[@]}" || { echo "post-lint failed"; exit 1; }
# a reply, inline comment or proposal is drafted from the whole thread: thread-context.md (mechanisms) next to the draft, newer than the comment it answers
kind=reply; for i in "${!flags[@]}"; do [ "${flags[$i]}" = --kind ] && kind="${flags[$((i+1))]}"; done
case "$kind" in reply|comment|inline|proposal)
  parent="${d%.md}.parent.md"; [ -f "$parent" ] || parent=""
  "$(dirname "$(readlink -f "$0")")/thread-context" --verify "$(dirname "$(readlink -f "$d")")/thread-context.md" ${parent:+--parent "$parent"} || exit 1;;
esac
out=$(tr -d '\r' < "$r" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' || true)
[ "$out" = "CLEAN" ] || { echo "review is not exactly CLEAN (it has $(printf '%s\n' "$out" | wc -l) non-empty lines; last: $(printf '%s\n' "$out" | tail -1)). The reviewer's final message, alone, is the review output"; exit 1; }
# a posted promise is a task opened (mergeworthy:github-threads): it needs a PROMISED line naming this draft in proposals-open.md
own=$(sed -E 's/"[^"]*"//g; s/“[^”]*”//g; s/`[^`]*`//g; /^>/d' "$d")  # quoted text is someone else's words, not a promise
if printf '%s\n' "$own" | grep -qiE "\b(I'll|I will)\b|follow-up PR|subsequent PR|separate PR" && ! printf '%s\n' "$own" | grep -qiE "\b(and|then) I'll (squash-)?merge"; then
  po="$(dirname "$(readlink -f "$d")")/../proposals-open.md"
  grep -q "^PROMISED .*$(basename "$d")" "$po" 2>/dev/null || { echo "the draft promises work: add 'PROMISED <thread>: <what> ($(basename "$d"))' to $po first, or do it now and write 'Done in <link>'"; exit 1; }
fi
# A maintainer who asked to see how this methodology changes (~/.mergeworthy/harness-shown/<owner>, the last mergeworthy
# commit shown there) gets one line linking every commit since: added here, after the review, so the reviewer never sees it
repo=""; for i in "${!flags[@]}"; do [ "${flags[$i]}" = --repo ] && repo="${flags[$((i+1))]}"; done
hs="${MERGEWORTHY_HOME:-$HOME/.mergeworthy}/harness-shown/${repo%%/*}"
installed=$(git -C "${MERGEWORTHY_SRC:-$HOME/.claude/plugins/marketplaces/mergeworthy}" rev-parse --short=7 HEAD 2>/dev/null || true)
shown=$(cat "$hs" 2>/dev/null | head -c 40 | tr -d '[:space:]' || true)
case "$kind" in reply|comment|proposal)
  if [ -n "$repo" ] && [ -f "$hs" ] && [ -n "$installed" ] && [ "$shown" != "$installed" ]; then
    printf '\nHarness changes since my last note: <https://github.com/nitedani/mergeworthy/compare/%s...%s>\n' "$shown" "$installed" >> "$d"
  fi;;
esac
sha256sum "$d" | cut -d' ' -f1 > "$d.gate"
# the draft was written from the thread's record, and the reviewer had the same file: it predates the draft's last edit;
# its hash goes into the gate record, so the posting hook can tell it from one made after the review
tcf="$(dirname "$(readlink -f "$d")")/thread-context.md"
if [ -f "$tcf" ]; then
  [ "$tcf" -nt "$d" ] && { rm -f "$d.gate"; echo "thread-context.md is newer than the draft: it was made after drafting. Re-read it, revise the draft if it changes anything, and review again (mergeworthy:writing step 0)"; exit 1; }
  echo "tc $(sha256sum "$tcf" | cut -d' ' -f1)" >> "$d.gate"
fi
echo "gate passed: $d"
# the draft now links every mergeworthy commit up to the installed one: record it as shown
case "$kind" in reply|comment|proposal) [ -n "$repo" ] && [ -f "$hs" ] && [ -n "$installed" ] && echo "$installed" > "$hs";; esac
# Register the post, so the watcher can tell the agent's posts from the user's when both use one account
REG="${GATED_POSTS:-$HOME/.claude/gated-posts.txt}"
python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1]).read().replace("\r\n","\n").strip().encode()).hexdigest())' "$d" >> "$REG"
