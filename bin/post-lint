#!/usr/bin/env python3
"""post-lint <draft.md> [--kind reply|pr|issue|inline|tracker|proposal|title] [--draft] [--parent <file>|none]: checks a draft before it is posted to GitHub.
Exit 1 with one line per finding. Checks: banned phrases, "stacked on" without gh stack, bare #N refs
(must be owner/repo#N unless --repo matches), length budgets, unclassified maintainer notes, em dashes,
process machinery in the thread, decisions not shown as code and lettered options, questions without a recommendation, and a bare "Done" answering a question.
A reply or inline comment needs the comment it answers: <draft stem>.parent.md next to it, or --parent <file>;
--parent none for a comment that answers nobody. --draft (with --kind pr): the body of a draft PR, which says why it is one.
Settings: MERGEWORTHY_BADGE on|off|auto requires the badge always, never, or for a human account."""
import hashlib, os, re, sys, subprocess, urllib.parse
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'hooks'))
import post_words
def setting(name, default):
    """MERGEWORTHY_<name> from the environment, else from ~/.mergeworthy/settings.env (written at session start from the plugin's options)."""
    f = os.path.expanduser('~/.mergeworthy/settings.env')
    saved = dict(l.strip().split('=', 1) for l in open(f) if '=' in l) if os.path.exists(f) else {}
    return os.environ.get(f'MERGEWORTHY_{name}') or saved.get(f'MERGEWORTHY_{name}', default)
args = sys.argv[1:]
USAGE = "usage: post-lint <draft.md> [--kind reply|pr|issue|inline|tracker|proposal|title] [--draft] [--repo owner/repo] [--parent <file>|none]"
def arg(name, default):
    if name not in args: return default
    i = args.index(name)
    if i + 1 >= len(args): sys.exit(USAGE)
    return args[i + 1]
if not args: sys.exit(USAGE)
path = args[0]; kind = arg('--kind', 'reply'); repo = arg('--repo', None)
kind = {'comment': 'reply'}.get(kind, kind)
_repo, _why = (repo, None) if repo else post_words.draft_repo(path)  # the language only: the other repo checks keep needing --repo
W = post_words.words(_repo)  # the words the checks look for, in the repo's language
RATED = re.compile(r'^\s*\|.*(?:[0-9]+|\bnew) *(?:⇒|=>) *(?:[0-9]+|removed|new|n/a)', re.M)  # a row rating an item old ⇒ new (`7 ⇒ 9`, `7/10 => 9/10`, `new ⇒ 9`)
REVIEWED = re.compile(r'^\|\s*Commit\s*\|.*\|\s*Rating\s*\|', re.M)  # the commit-review table's header (reply §Maintainer commits)
TABLE = r'(?:^[ \t]*\|[^\n]*\n?)+'
def fence_spans(s):
    """(start, end, inner) of each fenced code block in s, by CommonMark: an opening run of 3+ backticks or tildes indented up to 3 spaces
    (a backtick fence's info string holds no backtick), closed by a run of the same character at least as long, indented up to 3 spaces
    with nothing after it, or by the end of s. The one place post-lint decides what renders as code."""
    spans, pos, opened = [], 0, None
    for l in s.splitlines(True):
        m = re.match(r' {0,3}(`{3,}|~{3,})([^\n]*)', l)
        if opened is None:
            if m and not (m[1][0] == '`' and '`' in m[2]): opened = (pos, m[1], pos + len(l))
        elif m and m[1][0] == opened[1][0] and len(m[1]) >= len(opened[1]) and not m[2].strip():
            spans.append((opened[0], pos + len(l), s[opened[2]:pos])); opened = None
        pos += len(l)
    return spans + ([(opened[0], len(s), s[opened[2]:])] if opened else [])
def uncoded(s, keep=lambda block: ''):  # s with each fenced code block replaced by keep(block)
    out, last = [], 0
    for a, b, _ in fence_spans(s): out += [s[last:a], keep(s[a:b])]; last = b
    return ''.join(out) + s[last:]
VISIBLE = lambda s: uncoded(re.sub(r'<!--[\s\S]*?-->', '', s))  # what GitHub renders as text: no HTML comments, no fenced code
BOUND = 45  # words a rated row's rendered cell, or its table's header in all, leaves out of the count: #3609's longest rating reason is 45
def cells(l):  # a table line's cells as GitHub splits them: an escaped \| stays inside its cell
    return re.split(r'(?<!\\)\|', re.sub(r'(?<!\\)\|\s*$', '', re.sub(r'^\s*\|', '', l.rstrip('\n'))))
def rating_rows(t):
    """The line numbers of table t's rows that rate an item: an old ⇒ new row, or a commit-review row whose Rating cell holds N/10."""
    lines = t.splitlines()
    head = [c.strip() for c in cells(lines[0])]
    col = head.index('Rating') if REVIEWED.match(lines[0].lstrip()) else None
    rows = {i for i, l in enumerate(lines) if RATED.match(l) or col is not None and i and
            re.search(r'\b\d+(?:\.\d+)?/10\b', (cells(l) + [''] * len(head))[col])}
    return rows
def unrated(s):
    """(s, n): outside fenced code, each rated row becomes a plain line of the words past BOUND in each of its cells (as GitHub splits
    them), and its table's first line the words past BOUND in all; the table's other rows stay; n is the number of rated rows."""
    n = 0
    def rest(m):
        nonlocal n
        t = m.group(0); r = rating_rows(t); n += len(r)
        cell = lambda c: re.findall(WORD, re.sub(r'https?://\S+', 'URL', re.sub(r'\[([^\]]*)\]\([^)]*\)', r'\1', c)))  # words as counted below
        over = lambda l: ' '.join(w for c in cells(l) for w in cell(c)[BOUND:])
        head = lambda l: ' '.join(cell(l.replace('|', ' '))[BOUND:])  # a header is exempt up to BOUND words in all
        return ''.join((over(l) if i in r else head(l)) + '\n' if i in r or r and i == 0 else l for i, l in enumerate(t.splitlines(True)))
    out, last = [], 0
    for a, b, _ in fence_spans(s) + [(len(s), len(s), '')]: out += [re.sub(TABLE, rest, s[last:a], flags=re.M), s[a:b]]; last = b
    return ''.join(out), n
WORD = r"[A-Za-z0-9][\w'’-]*"
draft = '--draft' in args
if kind not in ('reply', 'pr', 'issue', 'inline', 'tracker', 'proposal', 'title') or draft and kind != 'pr': sys.exit(USAGE)  # tracker: umbrella body or decisions comment, a growing list with no word budget
record = kind == 'tracker'  # the umbrella issue: a growing list with no word budget
text = open(path).read()
if kind == 'title':  # a PR title (pull-request step 7): the squash subject and changelog line, one line, no badge
    lines = [l for l in text.split('\n') if l.strip()]
    bad = (["a title is one line"] if len(lines) != 1 else []) + \
          (["no badge or HTML in a title"] if lines and '<' in lines[0] else []) + \
          (["a title ends without a period"] if lines and lines[0].rstrip().endswith('.') else [])
    for f in bad: print(f)
    if not bad:
        open(path + '.lint', 'w').write(' '.join(args[1:]))
        open(path + '.lint.sha', 'w').write(hashlib.sha256(open(path, 'rb').read()).hexdigest())
    sys.exit(1 if bad else 0)
# An issue draft's first line may be its title ("Title: …"): the budget is for the body
title = (re.match(r'\ATitle:\s*([^\n]*)\n', text) or [None, None])[1]
text = re.sub(r'\ATitle:[^\n]*\n', '', text)
text = re.sub(r'\n*^Harness changes since my last note: <\S+>\n*\Z', '\n', text, flags=re.M)  # gate-pass's own line, after the review
# Posts by the agent share the user's account: each starts with the icons of the agents that worked on it,
# optionally followed on the same line by one italic line saying which model did what, then a line break,
# so readers see who wrote it. The other checks run on the text after the badge.
BADGE = re.compile(r'^(?:<img src="[^"]+"[^>]*alt="[^"]+"[^>]*>[ \t]*)+(?:\*[^*\n]+\*[ \t]*)?\n')
_label = re.match(r'^\s*<img [^>]*>[ \t]*\*\*[^*\n]+:\*\*', text)
_m = BADGE.match(text.lstrip())
if _m:
    text = text.lstrip()[_m.end():].lstrip()
# The author's prose, which the checks below lint: no code (fenced, inline), quotes of others or HTML comments. The count has its
# own rules: a PR body's adds prose-like code lines; every other post's reads its own text, code included (see Reading cost).
prose = re.sub(r'<!--.*?-->', '', text, flags=re.S)
# A reader who asked for the full lists (a refactor prompt's ratings, "100 questions with A/B/C choices") gets them, collapsed in <details>: not linted or counted
_rp = arg('--parent', None); _rp = (re.sub(r'\.md$', '', path) + '.parent.md') if _rp is None else (None if _rp == 'none' else _rp)
_asked_list = bool(_rp and os.path.exists(_rp) and re.search(r'\brefactor this pr\b|\bold rating\b|\bratings?\b.*\blists?\b|\b\d+\s+(?:questions|items|options)\b|\bquestions?\b.*\b(?:checkbox|choices)\b', open(_rp).read(), re.I | re.S))
if _asked_list:
    prose = re.sub(r'<details>.*?</details>', '', prose, flags=re.S)
    prose = re.sub(r'(?m)^\s*(?:- \[[ xX]\] .*|\d+\. \*\*.*|\*Why it matters:.*)$', '', prose)
# The converge steps' runs, collapsed (converge step 5), are evidence: never linted; only a PR body's count reads this prose, so a reply counts them
prose = re.sub(rf'<details>\s*<summary>(?:{post_words.alt(W["blocks"])})[^<]*</summary>.*?</details>', '', prose, flags=re.S)
code = '\n'.join(inner for _, _, inner in fence_spans(prose))
prose = uncoded(prose)
prose = re.sub(r'^\s*(?:[-*]\s+)?>.*$', '', prose, flags=re.M)
prose = re.sub(r'`[^`\n]*`', 'CODE', prose)
# A PR body counts, outside its evidence blocks, the prose moved into a table or a code block (mergeworthy:writing): a sentence-long cell
# (more than 15 words besides numbers and inline code) or a row's only cell, except a rated row's and its header's first BOUND words a
# cell (unrated()), and a code line of six or more words with no flag, path, code symbol or `->` that isn't mostly numbers
long_cells, (unrated_prose, n_rated) = [], unrated(prose)
for l in re.findall(r'^\s*\|(.*)$', unrated_prose, flags=re.M):
    row = cells('|' + l)
    if not re.fullmatch(r'[\s:|-]*', l):  # a separator row
        long_cells += [c for c in row if len(row) == 1 or len([w for w in re.findall(WORD, c) if w != 'CODE' and not w[0].isdigit()]) > 15]
lines = [l for l in code.split('\n') if len(w := re.findall(WORD, l)) >= 6 and not re.search(r"[^\w\s,.;:'’\"()%-]|->|(^|\s)-", l)
         and sum(x[0].isdigit() for x in w) * 4 < len(w)]
counted = re.sub(r'^\s*\|.*$', '', unrated_prose, flags=re.M) + '\n' + '\n'.join(long_cells + lines)   # table rows: their prose cells only
counted = re.sub(r'!\[[^\]]*\]\([^)]*\)', '', counted)                  # images
counted = re.sub(r'\[([^\]]*)\]\([^)]*\)', r'\1', counted)              # links: keep the text
counted = re.sub(r'https?://\S+', 'URL', counted)
findings = [_why] if _why else []
if _label:
    findings.append("badge label: drop the '**Name:**' label; the icons, then a line break, then the text")
BANNED = [r'\bin this run\b', r"\bdoesn't establish\b", r'\bworth noting\b', r'\bhappy to\b', r'\blet me know\b',
          r'\bpushback welcome\b', r'\bsay the word\b', r'\bwant me to\b', r'\bshall I\b', r'\bif you want\b',
          r"\bif you'd rather\b", r'\byour call\b', r'\bI hope this helps\b', r'\bgreat question\b', r'\bdelve\b',
          r'\bleverage\b', r'\brobust\b', r'\bseamless(ly)?\b', r'\bcomprehensive\b', r'\bA risk I am handing over\b',
          r'\bthanks for the (LGTM|approval|review)\b', r"\bI'll treat\b", r'^\s*Understood\b']
for b in BANNED:
    for m in re.finditer(b, prose, flags=re.I | re.M):
        findings.append(f"banned phrase: {m.group(0).strip()!r}")
# A word that ranks how hard a problem is reads as "unsolvable" unless it says for what
for m in re.finditer(r'\b(fundamental|impossible(?! states?\b)|unsolvable|insurmountable)\b', prose, flags=re.I):
    n = re.match(r'\s+(\w+\s+)?(to|for)\b', prose[m.end():])
    if (m.start() and prose[m.start() - 1] in '"“\'') or (n and (n.group(2) == 'for' or m.group(1).lower() == 'fundamental')):
        continue  # quoted, or scoped: "fundamental to X", "impossible for X"
    findings.append(f"{m.group(0)!r}: say what it's hard for (\"a problem for one injection point\"), or the reader takes it as unsolvable")
# A newcomer can't decode an internal label, and a bold label with a fragment isn't a sentence (mergeworthy:writing)
_labels = re.findall(r'(?<![\w`/#.-])([A-Z])(\d{1,2})(?![\w`])', prose)
_series = {a for a in {a for a, _ in _labels} if len({n for b, n in _labels if b == a}) > 1}  # W2 and W5: a numbered series, not S3 or R2
for a, n in _labels:
    if a in _series:
        findings.append(f"internal label {a + n!r}: say what it is in plain words")
for m in re.finditer(r'(?<![\w`/#.-])R\*(?![\w`])', prose):
    findings.append("internal label 'R*': say what it is in plain words")
for m in re.finditer(r'^\s*[-*]\s+\*\*[^*\n]+\*\*:?\s+([^\n]*)$', prose, flags=re.M):
    if len(m.group(1).split()) < 6 and m.group(1).rstrip().endswith('.'):
        findings.append(f"a bold label with a fragment ({m.group(0).strip()[:60]!r}): write it as a full sentence")
# A paragraph opening with a bold label ("**Problem.**", "**Fix:**") reads as a report, not as the account owner talking (mergeworthy:writing)
if kind != 'tracker':
    for m in re.finditer(r'^\*\*([^*\n]{1,40}?)[.:]\*\*[ \t]+\S', prose, flags=re.M):
        if len(m.group(1).split()) <= 4 and not m.group(1).strip().isdigit():
            findings.append(f"a paragraph opening with a bold label ({m.group(0).strip()[:40]!r}): say it the way you would to a colleague")
# A label and a colon opening a sentence ("Done: …", "One change I didn't make: …") reads as a report line, not a person (mergeworthy:writing)
if kind in ('reply', 'inline', 'proposal', 'issue'):
    for m in re.finditer(r"(?:^|(?<=[.!?]\s))([A-Z][^:\n.!?`|*]{0,50}?):[ \t]+(?=\S)", prose, flags=re.M):
        if 1 <= len(m.group(1).split()) <= 6 and not re.search(r'\d$', m.group(1)):
            findings.append(f"a label opening a sentence ({m.group(0).strip()[:40]!r}): say it the way you would to a colleague")
# Crediting a decision or idea to someone needs a link to where they said it, or a summary becomes "you agreed" (mergeworthy:writing §How a colleague writes)
if kind in ('reply', 'inline', 'proposal', 'issue', 'pr'):
    _credit = r"\b(you|we|he|she|they|brillout|\w+ and I) (agreed|approved|proposed|suggested|signed off|decided)\b|\bas (agreed|you said|you suggested|you proposed)\b|\b(your|his|her|their) (design|proposal|suggestion|decision)\b|\bthe rule you\b"
    for sent in re.split(r'(?<=[.!?])\s+|\n{2,}', prose):
        if re.search(_credit, sent, flags=re.I) and not re.search(r'https?://|\]\(', sent):
            findings.append(f"credit without a link ({sent.strip()[:60]!r}): link where they said or agreed it, after re-reading the thread")
if '—' in prose:
    findings.append("em dash (—): rewrite the sentence")
for m in re.finditer(r'\bstacked on\b[^\n]*|\bstack(s|ed)? on (top of )?([\w.-]+/[\w.-]+)?#\d+[^\n]*', prose, flags=re.I):
    findings.append(f"'stacked on' claim ({m.group(0)[:60]!r}): only with gh stack; otherwise write 'depends on #N'")
for m in re.finditer(r'(?<![\w/.-])#(\d+)\b', prose):
    if not repo:
        findings.append(f"bare #{m.group(1)}: write owner/repo#{m.group(1)} (or pass --repo when it's the same repo)")
    else:
        _gl = repo.startswith('gitlab.com/')  # GitLab's #N is an issue of the same project too
        _r = subprocess.run(['glab', 'api', '--hostname', 'gitlab.com', f"projects/{urllib.parse.quote(repo[len('gitlab.com/'):], safe='')}/issues/{m.group(1)}"] if _gl else
                            ['gh', 'api', f'repos/{repo}/issues/{m.group(1)}', '--silent'], capture_output=True, text=True)
        if _r.returncode != 0 and 'HTTP 404' in _r.stderr:
            findings.append(f"bare #{m.group(1)} doesn't exist in {repo}: another repo's item? write owner/repo#{m.group(1)}")
        elif _r.returncode != 0:  # a rate limit or an outage proves nothing about the reference
            findings.append(f"bare #{m.group(1)}: couldn't check it in {repo} ({_r.stderr.strip()[:80]}); rerun post-lint when the API answers")
# the umbrella issue's format (mergeworthy:task §Umbrella; reference nitedani/vike-react-rsc#9)
if kind == 'tracker':
    head = re.sub(r'^\s*(?:<img [^>]*>[ \t]*)+\n\s*', '', text)  # after the agent badge
    _tt, _td, _ts = W['tracker']
    if head.startswith(f'## {_td}'):
        for h in _ts:
            if not re.search(rf'^### [^\n]*{re.escape(h)}', text, flags=re.M):
                findings.append(f"tracker: the {_td} comment needs a '### {h}' section (task §Umbrella)")
        if re.search(r'^### [^\n]*\bPRs\b', text, flags=re.M):
            findings.append("tracker: no '### PRs' in the Decisions comment: PR states live only in the body (task §Umbrella)")
    elif head.startswith('## '):
        pass  # a long record the body links to (e.g. an audit's findings): no list format
    else:
        if title is not None and not title.startswith(_tt):
            findings.append(f"tracker: the title starts '{_tt}' and names the goal, not {title[:50]!r} (task §Umbrella)")
        if re.search(r'^\s*\|.*\|\s*$', prose, flags=re.M):
            findings.append("tracker: items are checkboxes under '##' sections, not a table (task §Umbrella)")
        if not re.search(r'^## ', text, flags=re.M) or not re.search(r'^\s*- \[[ x]\] ', text, flags=re.M):
            findings.append("tracker: one '##' section per group of work, each item a '- [ ]' / '- [x]' checkbox (task §Umbrella)")
        # GitHub's comment link or GitLab's note link; the issue's creation comes before its Decisions comment, so only edits need it
        if title is None and not re.search(r'issuecomment-|/-/(?:issues|work_items)/\d+#note_\d', text):
            findings.append("tracker: link the Decisions comment ('All decisions made so far: <link> (kept up to date).') (task §Umbrella)")
        ref = r'(?:[\w.-]+/[\w.-]+)?#\d+(?!\d)'
        for m in re.finditer(rf'^\s*- \[x\] (~~)?({ref})(?:(?:,| and) {ref})*(?!(?:~~)? \()(?!(?:,| and) {ref})', text, flags=re.M):  # a ticked item (or a group of them) says how it ended
            findings.append(f"tracker: say how {m.group(2)} ended, in parentheses right after it, e.g. '{m.group(2)} (merged)' (task §Umbrella)")
# Reading cost (mergeworthy:writing §Length): every post but a PR body is counted from its own text, code and collapsed sections included;
# requested lists, quotes of others, and rated rows with their header (up to BOUND words a cell) are left out
if kind != 'pr':
    counted = re.sub(r'<!--.*?-->', '', text, flags=re.S)
    if _asked_list:  # the lists the reader asked for: collapsed, or open as a questionnaire (GitHub closes <details> on every box ticked)
        counted = re.sub(r'<details>.*?</details>', '', counted, flags=re.S)
        counted = re.sub(r'(?m)^\s*(?:- \[[ xX]\] .*|\d+\. \*\*.*|\*Why it matters:.*)$', '', counted)
    counted = re.sub(r'^\s*(?:[-*]\s+)?>.*$', '', counted, flags=re.M)              # quotes of others
    counted, n_rated = unrated(counted)  # the cap below counts the rated rows of this same text
    counted = re.sub(r'^\s*\|[\s:|-]+\|\s*$', '', counted, flags=re.M)            # table separator rows
    counted = re.sub(r'!\[[^\]]*\]\([^)]*\)', '', counted)
    counted = re.sub(r'\[([^\]]*)\]\([^)]*\)', r'\1', counted)
    counted = re.sub(r'https?://\S+', 'URL', counted)
    counted = re.sub(r'^(?:<img [^>]*>[ \t]*)+\n', '', counted)            # the badge
    if kind == 'issue':  # the reproduction steps a newcomer needs are required, not part of the budget
        counted = re.sub(r'^#+\s*How to reproduce\b.*?(?=^#+ |\Z)', '', counted, flags=re.S | re.M | re.I)
words = len(re.findall(r"[A-Za-z0-9][\w'’-]*", counted))
chars = len(re.sub(r'\s+', ' ', counted).strip())
sentences = len(re.findall(r'[.!?](?=\s|$)', re.sub(r'\b(e\.g|i\.e|etc|vs)\.', '', counted).strip())) or 1
# Reader load (mergeworthy:writing): comprehension falls sharply past about 20 words a sentence; bold loses its signal past ~30% of the text
if kind != 'pr':
    plain = re.sub(r'^\s*\|.*$', '', prose, flags=re.M)                     # tables aren't sentences
    plain = re.sub(r'^\s*(?:[-*]|\d+\.)\s+', '\n', plain, flags=re.M)        # a list item is its own sentence
    plain = re.sub(r'https?://\S+', 'URL', re.sub(r'\[([^\]]*)\]\([^)]*\)', r'\1', plain))
    sents = [x for x in re.split(r'(?<=[.!?:])\s+|\n{2,}', plain) if re.search(r'[A-Za-z]', x)]
    lens = [len(re.findall(r"[A-Za-z0-9][\w'’-]*", x)) for x in sents]
    for x, n in zip(sents, lens):
        if n > 40:
            findings.append(f"a {n}-word sentence: split it where a new point starts, keeping a cause and its effect together ({x.strip()[:60]!r}…)")
    if lens and sum(lens) / len(lens) > 25:
        findings.append(f"sentences average {sum(lens) / len(lens):.0f} words: split the long ones where a new point starts")
    bold = sum(len(re.findall(r"[A-Za-z0-9][\w'’-]*", b)) for b in re.findall(r'\*\*(.+?)\*\*', prose))
    if words_all := len(re.findall(r"[A-Za-z0-9][\w'’-]*", prose)):
        if bold / words_all > 0.3:
            findings.append(f"{bold / words_all:.0%} of the text is bold: bold only a bullet's lead-in or the decision")
# Answering several questions takes room: each question in the comment answered (beyond the first) adds 60 words
_pa = arg('--parent', None)
_pp = (re.sub(r'\.md$', '', path) + '.parent.md') if _pa is None else (None if _pa == 'none' else _pa)
_asked, cap = 0, None
if _pp and os.path.exists(_pp):
    _q = uncoded(open(_pp).read())                                                        # code blocks
    _q = '\n'.join(l for l in _q.splitlines() if not l.lstrip().startswith('>'))          # quotes of others
    _q = re.sub(r'`[^`]*`|https?://\S+', '', _q)                                         # inline code, URLs
    _asked = len(re.findall(r'\?+', _q))
    _pwords = len(re.findall(r"[A-Za-z0-9][\w'’-]*", re.sub(r'<[^>]+>|\*[^*\n]*\*', '', _q)))
    # a short comment (a question or an instruction in a line or two) gets a short answer: the result and its commit
    _cap = 80 + 60 * max(_asked - 1, 0) + 20 * n_rated  # 20 words per rated row the count left out: a pass's commits and what stays below the bar
    if kind == 'reply' and _pwords <= 25:
        cap = _cap
    if kind == 'reply' and _pwords <= 25 and words > _cap:
        findings.append(f"{words} words answering a {_pwords}-word comment (cap {_cap}" + (f" with {20 * n_rated} words for its {n_rated} rated row{'s' * (n_rated > 1)}" if n_rated else '') + "): give the answer and its commit in a few sentences, and keep a rated cell's reason within 45 words; "
                        "how the code or its tests work stays out unless they asked (writing, Draft by talking step 5)")
extra = 0  # however many questions: one plan, the rest linked
cap = min(cap or 300 + extra, 300 + extra) if kind == 'reply' else None
if kind == 'reply' and words > 300 + extra:
    findings.append(f"{words} words > {300 + extra} for a reply (a rated cell's words past 45 count too): cut what the reader doesn't need to decide, act or check, a whole sentence at a time, never single words out of a sentence that stays")
pr_budget = 300  # what's broken and what the PR changes need room; data tables, code and the collapsed evidence don't count
cap = pr_budget if kind == 'pr' else cap
if kind == 'pr' and words > pr_budget:
    findings.append(f"{words} words > {pr_budget} for a PR body (data tables, code, images and URLs not counted; prose in a table or code block is): cut what the reader doesn't need a whole sentence or row at a time, never what's broken or why, and never single words out of a sentence that stays")
    for t in re.findall(r'<summary>([^<]*)</summary>', prose):  # the evidence blocks are gone from prose: any summary left is counted
        findings.append(f"the {t.strip()!r} block's words count toward {pr_budget}: a converge step's evidence block starts its <summary> with {', '.join(W['blocks'])} (converge §Evidence blocks), "
                        "and post-lint neither counts nor lints it; cut or shorten any other block")
# A draft PR's body says why it's a draft on a bold line right under the badge; a ready PR's body has no such line (mergeworthy:writing)
STATE = post_words.state_line(W); _state = f"**{W['state'][0]}: {W['state'][1]}**"
if kind == 'pr' and draft and not STATE.match(next((l.strip() for l in text.split('\n') if l.strip()), '')):
    findings.append(f"a draft PR's body starts, right under the badge, with '{_state} (<why it's a draft, in plain words>)'")
if kind == 'pr' and not draft and re.search(rf'^\s*\*\*{re.escape(W["state"][0])}:', prose, re.M):
    findings.append("this PR isn't a draft: remove the State line (or lint the draft's body with --draft)")
# A PR body opens with what's broken and what the PR changes, never with its status (mergeworthy:writing); the State line comes before that opening
_first = next((l for l in prose.split('\n') if l.strip() and not l.lstrip().startswith(('#', '|', '<', '![', f"**{W['state'][0]}:"))), '')
if kind == 'pr' and re.match(r'\s*(Draft|Depends|Blocked|Waiting|Stacked|WIP|Status|Note)\b', _first, re.I):
    findings.append(f"the PR body opens with its status ({_first.strip()[:40]!r}): open with what's broken and what this PR changes, in a user's words; status goes after")
# pull-request §Body's template: a ready PR's body shows what you should see, as numbered evidence (a request and its
# response, an image) outside the collapsed blocks (magne4000/universal-middleware#432 comment 6111310596)
if kind == 'pr' and not draft:
    _open = re.sub(r'<details\b.*?</details>', '', text, flags=re.S)
    _see = re.search(rf'^###\s+{re.escape(W["see"])}\s*$(.*?)(?=^###\s|\Z)', _open, re.M | re.S)
    if not _see or not re.search(r'^\*\*1\.\*\*', _see.group(1), re.M) or not re.search(r'```|!\[|<img\b', _see.group(1)):
        findings.append(f"pull-request §Body: the body has '### {W['see']}' with numbered items (**1.** …), each showing the evidence itself: a real request and response, or an image")
# A PR's screenshots and videos come in base/head pairs: screenshots in a before/after table, videos under Before/After labels (evidence step 4)
_ls = text.split('\n')
_prev = lambda k: next((l.strip() for l in reversed(_ls[:k]) if l.strip()), '')
_bad = [l for k, l in enumerate(_ls) if re.search(r'!\[[^\]]*\]\(|<img\b', l) and not re.search(r'github\.com/[\w-]+\.png', l)
        and not (re.search(r'\.(?:mp4|webm|mov)\b', l, re.I) and re.match(r'\*\*(?:Before|After|Előtte|Utána)\b', _prev(k), re.I))
        and not (l.lstrip().startswith('|') and re.search(r'^\|.*\b(?:before|előtte|base|main|master)\b.*\|.*\b(?:after|utána|this (?:PR|MR)|head)\b.*\|\s*$', text, re.M | re.I))]
if kind == 'pr' and _bad:
    findings.append(f"{len(_bad)} screenshot or video line(s) not in a before/after pair: screenshots go in rows of `| What | Before (<base>) | After (this PR) |`, "
                    "videos under `**Before (<base>)**` and `**After (this PR)**` paragraphs, the same step, data and width on both branches (evidence step 4)")
if kind == 'proposal' and words > 900 + extra:  # a design walkthrough (mergeworthy:design step 8)
    findings.append(f"{words} words > {900 + extra} for a design answer or walkthrough (tables and code count): a dump: cut what the reader doesn't need to decide, act or check (mergeworthy:writing)")
# Parallel, not later (task §Dispositions): work promised for "after it" or "later" is deferred, not waiting on anything named
if kind in ('reply', 'proposal', 'inline') and (_d := re.search(r"\bI(?:'ll| will)\b[^.\n]*?\b(?:after (?:it|that|this)|later)\b", prose)):
    findings.append(f"{_d.group(0)!r} defers work: start a quick win now, or name the dependency or decision it waits on (task §Dispositions)")
decision = kind == 'issue' and re.search(r'^#+\s*Options\b', text, re.I | re.M)  # a decision issue (open-issue)
if decision and words > 400 + extra:
    findings.append(f"{words} words > {400 + extra} for a decision issue (tables and code count): the options a user would see and your pick; cut the rest")
if kind == 'issue' and not decision and chars > 400:
    findings.append(f"{chars} characters > 400 for an issue (tables, code, images and URLs not counted): keep one finding")
# a code location the reader can't click is one they can't find (elysiajs/elysia#2018: bare `:160`, "off Bun")
_loc = uncoded(text)
_loc = re.sub(r'^\s*(?:[-*]\s+)?>.*$', '', _loc, flags=re.M)
_loc = re.sub(r'\[(?:[^\[\]]|\[[^\]]*\])*\]\([^)]*\)', '', _loc)  # linked text, `[x](url)` included
_locs = re.findall(r'[\w./-]+\.(?:[cm]?[jt]sx?|py|rs|go|vue|svelte|java|rb|php|css|html?|json|ya?ml|toml):\d+(?:-\d+)?\b|\blines? \d+(?:[-–]\d+)?\b', _loc)
if _locs:
    findings.append(f"code location without a link: {', '.join(dict.fromkeys(_locs))}: link each to the line at a commit (a permalink), so a reader can open it")
# a newcomer must see where it is and how to reproduce it (lexunit-ai/atotal_vagyon_borze#49 comment 6017184273)
if kind == 'issue':
    shown = re.sub(r'^(?:<img [^>]*>[ \t]*)+\n', '', text)  # the badge is no evidence
    repro = re.search(r'^#+\s*(?:how to (?:see|reproduce)|steps to reproduce)\b.*?(?=^#+ |\Z)', shown, re.I | re.M | re.S)
    video = re.search(r'<video|\.(?:mp4|webm|mov)\b', shown, re.I)
    still = re.search(r'<img|\.(?:png|jpe?g|gif|webp)\b', shown, re.I)
    steps = len(re.findall(r'^\s*\d+\.\s', repro.group(0), re.M)) if repro else 0
    if not repro:
        findings.append("an issue with no '### How to reproduce': the role or URL, each action, what you see, so a newcomer reaches it (open-issue)")
    if not (video or still or '```' in shown):
        findings.append("an issue with no evidence: a screenshot, a video of the flow, or the request and response in a code block when no screen shows it (evidence)")
    elif still and not video and steps > 3:
        findings.append(f"{steps} steps to reach it, shown only in stills: record a video of the whole flow (evidence)")
if kind == 'inline' and sentences > 2:
    findings.append(f"{sentences} sentences > 2 for an inline comment")
# maintainer notes must be classified
_blocks = W['notes'][2].split()[0].lower()  # the notes table's "Blocks merge" column, its first word
for m in re.finditer(rf'^\s*(?:[-*]|\d+\.)?\s*\*\*({post_words.alt(W["note"])})[^\n]*', text, flags=re.M | re.I):
    line = m.group(0)
    if not re.search(rf'\b({post_words.alt(W["kinds"])})\b', line, re.I) or not re.search(re.escape(_blocks), line, re.I):
        findings.append(f"unclassified note: {line.strip()[:70]!r} needs <{'|'.join(W['kinds'])}> · {_blocks} …: yes/no · next: …, or is a '### {W['decision']}:' block (writing)")
if len(re.findall(rf'^\s*(?:[-*]|\d+\.)\s+[^\n|]*·\s*{re.escape(_blocks)}', text, flags=re.M | re.I)) >= 2:
    findings.append(f"notes as a list of 'kind · {_blocks} · next' lines: put them in one table | {' | '.join(W['notes'])} |")
# a decision is code, the output per lettered option, then our pick; never a table row (writing; magne4000/universal-middleware#434 comment 6112728923)
DECIDE = f"a '### {W['decision']}: <the choice>' block: the smallest code that shows it, then (a), (b) with each output, then '{W['picked'][0]}' (writing)"
if kind in ('pr', 'proposal', 'reply'):
    for row in re.findall(r'^\|[^|\n]*\|\s*decision[ -]needed\s*\|[^\n]*$', text, flags=re.M | re.I):
        findings.append(f"decision as a table row ({row.strip()[:50]!r}): make it {DECIDE}")
    _unhead = uncoded(text, lambda c: re.sub(r'^#', ' ', c, flags=re.M))  # a '#' line in code isn't a heading
    _head = r'decision\b|[^\n]*\b(?:decision needed|for you to decide|left to you|choose one)\b' if W['decision'] == 'Decision' else rf'{re.escape(W["decision"])}\b'
    for m in re.finditer(rf'^(?:#{{1,6}}\s+|\*\*)(?:{_head})[^\n]*\n(.*?)(?=^#{{1,6}}\s|\Z)', _unhead, flags=re.M | re.S | re.I):
        body = m.group(1)
        code = (fence_spans(body) or [None])[0]
        after = body[code[1]:] if code else ''
        if not (code and re.search(r'^\s*(?:[-*]\s+)?(?:\*\*)?\(a\)', after, re.M) and re.search(r'^\s*(?:[-*]\s+)?(?:\*\*)?\(b\)', after, re.M)
                and re.search(W['picked'][1], after)):
            findings.append(f"decision block {m.group(0).splitlines()[0].strip()[:50]!r} isn't {DECIDE}")
# evidence carries no secret (post §Thread rules): checked on the whole text, code blocks included, where logs usually sit
SECRET = re.compile(r'ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|\bsk-[A-Za-z0-9_-]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}'
                    r'|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|^\s*(?:authorization|cookie|set-cookie)\s*:\s*(?:bearer\s+|basic\s+)?(?!<REDACTED>)\S{12,}',
                    re.I | re.M)
for m in SECRET.finditer(text):
    findings.append(f"secret-shaped text {m.group(0)[:12]!r}...: write <REDACTED> in its place")
# a limitation names what imposes it: one our own design creates is a defect (code §No regressions)
for row in re.findall(rf'^\|([^|\n]*)\|\s*{re.escape(W["kinds"][1])}\s*\|[^\n]*$', text, flags=re.M | re.I):
    whole = re.search(r'^\|' + re.escape(row) + r'\|[^\n]*$', text, flags=re.M).group(0)
    if not re.search(re.escape(W['imposed']), whole, re.I):
        findings.append(f"limitation {row.strip()[:50]!r} names nothing that imposes it: say '{W['imposed']} <runtime, provider or protocol>', or fix it, since a limit our own design creates is a defect (code §No regressions)")
# a follow-up is opened before the post, never parked as advice (mergeworthy:writing §Forms, task §Dispositions)
for row in re.findall(r'^\|(?:[^|\n]*\|){3}([^|\n]*)\|\s*$', text, flags=re.M):
    if re.search(r'\b(recommend|follow-up|follow up|later)\b', row, re.I):
        findings.append(f"notes table Next {row.strip()[:50]!r}: open the follow-up first and link it (PR <url>), fix it (fixed in <sha>), or write 'nothing, because …'")
# a found defect is fixed in this change, not parked in prose (mergeworthy:task §Dispositions): the same bug elsewhere is related
for m in re.finditer(r"[^.\n]*\b(separate issue|separate PR|out of scope|left for later|for later|a later PR|follow-up issue|another PR)\b[^.\n]*", prose, re.I):
    findings.append(f"deferral {m.group(0).strip()[:70]!r}: fix it in this change, open the PR now and link it, or quote the user's OK (task §Dispositions)")
has_badge = _m is not None
badge = setting('BADGE', 'on')  # auto: only a human account (`gh api user` type User, not Bot) needs it
if kind != 'tracker' and not has_badge and not _label and (badge == 'on' or badge == 'auto' and
        subprocess.run(['gh', 'api', 'user', '--jq', '.type'], capture_output=True, text=True).stdout.strip() == 'User'):
    findings.append("missing badge: start the post with the icon of each agent that worked on it, then a line break; no label")
# Codex worked on it when its run left a trace next to the draft (a codex log, or its "model: gpt…" banner): its icon belongs in the badge
_dir = os.path.dirname(os.path.abspath(path))
def _codex_trace(f):
    if 'codex' in f.lower(): return True
    if not f.endswith(('.log', '.out')) or os.path.getsize(os.path.join(_dir, f)) > 2_000_000: return False
    return re.search(r'^model: gpt', open(os.path.join(_dir, f), errors='replace').read(), re.M) is not None
if has_badge and kind != 'tracker' and '*' not in _m.group(0):
    findings.append("badge without its model line: after the icons, on the same line, add *<model version> (<effort> effort) wrote this; …* in italics (writing, the badge)")
# each model in the model line carries its reasoning effort: "Opus 5.5 (high effort)", "GPT-6.1-Sol (Codex, high effort)"
if has_badge and kind != 'tracker' and '*' in _m.group(0):
    _line = re.sub(r'\]\([^)]*\)', ']', _m.group(0).split('*', 1)[1])  # link targets aren't model names
    _effort = rf'\b(?:{post_words.alt(W["effort"])}) {re.escape(W["effort_word"])}\b'
    _bare = [m.group(1) for m in re.finditer(rf'\b([A-Z][A-Za-z]*[ -]?\d+(?:\.\d+)*(?:-[A-Za-z0-9]+)*)(?![\w-]|\.\w)(?!\s*\([^()]*{_effort}[^()]*\))', _line)]
    if _bare or not re.search(_effort, _line):
        _e = f"{W['effort'][2]} {W['effort_word']}"
        findings.append(f"model line without effort{' for ' + ', '.join(_bare) if _bare else ''}: add each model's configured reasoning effort right after its name, \"Opus 5.5 ({_e})\" or inside its parenthesis, \"GPT-6.1-Sol (Codex, {_e})\" (writing, the badge)")
if has_badge and 'alt="Codex"' not in _m.group(0) and any(_codex_trace(f) for f in os.listdir(_dir) if os.path.isfile(os.path.join(_dir, f))):
    findings.append('badge without Codex: Codex worked on this post (a codex run left its log next to the draft), so add <img src="https://github.com/openai.png" width="20" height="20" alt="Codex">')
# the process stays in the work folder: the reader gets results, not how the agent produced them
if not record:
    PROCESS = [r'\breview rounds?\b', r'\b(refactor|verification|dry) pass(es)?\b', r'\bcharter\b', r'\bgpt-\d[\w.-]*',
               r'\bcodex\b', r'\bsub-?agents?\b', r'\bout of credits\b', r'\bCHANGES-REQUESTED\b', r'\b(posting|fast) gate\b',
               r'\b\d+(\.\d+)?/10\b', r'\brated (every|each)\b']
    # A maintainer who asks for a review ("Review each of my commits") wants per-item ratings: allowed then
    _parent = re.sub(r'\.md$', '', path) + '.parent.md'
    _parent = arg('--parent', None) if arg('--parent', None) not in (None, 'none') else _parent
    # ...and so does a shown commit-review table (| Commit | What it does, and the idea behind it | Rating |); a shown old ⇒ new row
    # (`7 ⇒ 9`, `new ⇒ 9`, delegate/shape.md) also allows "rated every/each"; a row in an HTML comment or fenced code allows nothing
    _shown = VISIBLE(text)
    if RATED.search(_shown) or REVIEWED.search(_shown) or \
            (__import__('os').path.exists(_parent) and re.search(r'\breview\b', open(_parent).read(), re.I)):
        PROCESS = [b for b in PROCESS if '/10' not in b and not ('rated' in b and RATED.search(_shown))]
    # A maintainer who asks how the work was made (models, agents, orchestration, the harness) gets that answer: allowed then
    # ...and so does the methodology's own repo, where the process is the subject
    if (repo or '').lower() == 'nitedani/mergeworthy' or (__import__('os').path.exists(_parent) and re.search(r'\b(AI models?|models?|agents?|sub-?agents?|orchestrat\w*|harness|effort|Codex|Opus|Haiku|Claude)\b', open(_parent).read(), re.I)):
        PROCESS = []
    for b in PROCESS:
        for m in re.finditer(b, prose, flags=re.I):
            findings.append(f"process in the thread: {m.group(0)!r}: " + ("put the ratings in an old ⇒ new table in this post (`| item | 7 ⇒ 9 | commit |`), or drop the word"
                            if '/10' in b or 'rated' in b else "say what changed, not how it was produced (a rating table can stay); keep rounds, reviewers and models in the work folder"))
# a question to the reader carries our recommendation
asks = [q.strip() for q in re.findall(r'[^.!?\n]*\?(?=\s|$)', prose)]
if not record and asks and not re.search(rf"\b({W['recommend']})\b|^GENUINE-FORK:", prose, re.I | re.M):
    findings.append(f"question without your recommendation ({asks[0][-60:]!r}): decide or measure it yourself, or say what you'd pick and why")
# a bare "Done" to a question or a soft suggestion: say what you checked, or push back
if kind in ('reply', 'inline'):
    parent_arg = arg('--parent', None)
    stem = re.sub(r'\.md$', '', path) + '.parent.md'
    parent_path = parent_arg if parent_arg not in (None, 'none') else (stem if parent_arg is None else None)
    if parent_arg is None and not __import__('os').path.exists(stem):
        findings.append(f"no parent: save the comment you answer as {stem}, or pass --parent none for a comment that answers nobody")
    elif parent_path:
        parent = open(parent_path).read()
        suggestion_block = re.search(r'^```suggestion', parent, re.M)
        parent_prose = uncoded(parent)
        parent_prose = re.sub(r'^\s*>.*$', '', parent_prose, flags=re.M)
        question = re.search(r"\?|\b(how about|what about|I think|maybe|shouldn't|why|would it|could we|can we|isn't)\b", parent_prose, re.I)
        bare = re.sub(r'\b[0-9a-f]{7,40}\b|\([^)]*\)', '', counted)
        if question and not suggestion_block and re.match(r'\s*(Done|Fixed|Removed|Applied|Changed|Reverted|Updated)\b', counted) \
                and len(re.findall(r"[A-Za-z][\w'-]*", bare)) <= 4:
            findings.append("bare 'Done' answering a question or a soft suggestion: say what you checked and why you agree, or push back")
for f in findings: print(f)
# post step 3: the reviewer weighs each finding that adds words against this
print(f"length: {words} words, " + (f"cap {cap}" if cap else "no cap"), file=sys.stderr)
if not findings:  # gate-pass re-runs post-lint with the flags this draft passed with
    with open(path + '.lint', 'w') as f: f.write(' '.join(args[1:]))
    with open(path + '.lint.sha', 'w') as f: f.write(hashlib.sha256(open(path, 'rb').read()).hexdigest())  # pre-agent-dedupe: no review of an unlinted draft
sys.exit(1 if findings else 0)
