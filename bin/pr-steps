#!/usr/bin/env bash
# pr-steps <step> <output-file>: records that a converge step ran on the current HEAD, after checking its output proves it.
# Steps, in pipeline order (mergeworthy converge): verify (Loop A), loopb (Loop B's review), refactor (Loop B's ratings),
# reverify (Loop A after Loop B's commits), fresh (the fresh reader), gates (every gate's exit code on the final head).
# The posting hook blocks `gh pr create` (unless --draft), `gh pr ready` and pushes to a ready PR until HEAD has all six.
set -euo pipefail
step=${1:?usage: pr-steps <approach|verify|loopb|refactor|reverify|fresh|gates> <output-file>}; out=${2:?output file}
case "$step" in approach|verify|loopb|refactor|reverify|fresh|gates) ;; review) step=fresh ;; *) echo "step must be approach, verify, loopb, refactor, reverify, fresh or gates" >&2; exit 1;; esac
[ -s "$out" ] || { echo "$out is empty: run the step and save its output" >&2; exit 1; }
last=$(grep -v '^[[:space:]]*$' "$out" | tail -n1)
sha=$(git rev-parse HEAD)
if [ "$step" = approach ]; then
  # one record per repo and branch; the guard computes the same key
  key=$(printf '%s\n%s' "$(realpath "$(git rev-parse --git-common-dir)")" "$(git symbolic-ref --short -q HEAD || echo HEAD)" | sha256sum | cut -c1-40)
  chosen=$(sed -n 's/^[[:space:]]*Chosen:[[:space:]]*//p' "$out" | head -n1 | sed 's/[[:space:]]*$//')
  [ -n "$chosen" ] || { echo "$out has no line 'Chosen: <candidate>'" >&2; exit 1; }
  # candidates: table rows `| name | rating 0-10 | why |`; the header and separator rows have no numeric rating
  rows=$(awk -F'|' '/^[[:space:]]*\|/ { for (i=1;i<=NF;i++) gsub(/^[[:space:]]+|[[:space:]]+$/,"",$i); if ($3 ~ /^([0-9]|10)(\/10)?$/ && $2 != "" && $4 != "") { sub(/\/10$/,"",$3); print tolower($2) "\t" $3 } }' "$out")
  [ "$(printf '%s' "$rows" | grep -c .)" -ge 2 ] || { echo "$out lists fewer than two rated candidates: a table '| Candidate | Rating | Why |' with each candidate, not building it included, rated 0-10 with its reason" >&2; exit 1; }
  rating=$(printf '%s\n' "$rows" | awk -F'\t' -v c="$(printf '%s' "$chosen" | tr 'A-Z' 'a-z')" '$1==c {print $2; exit}')
  [ -n "$rating" ] || { echo "Chosen '$chosen' is not a row of the candidates table" >&2; exit 1; }
  [ "$rating" -ge 7 ] || { echo "the chosen approach is rated $rating: 6 or below is not ready to build (pull-request step 3); find a better candidate or stop" >&2; exit 1; }
  # browser control is proven before building: a screenshot it took of this app, or why the change has no UI or runtime behavior
  browser=$(sed -n 's/^[[:space:]]*Browser:[[:space:]]*//p' "$out" | head -n1 | sed 's/[[:space:]]*$//')
  case "$browser" in
    /*) [ "$(head -c8 "$browser" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 89504e470d0a1a0a ] || { echo "Browser: $browser is not a PNG file" >&2; exit 1; } ;;
    "none, because "?*) ;;
    *) echo "$out has no line 'Browser: <absolute path of a PNG screenshot browser control took of this app on this machine>' or 'Browser: none, because <why this change has no UI or runtime behavior>'. Before building, try browser control on the app's real URL: the session's browser MCP first, then a Chrome or Playwright you launch, accepting the dev host's self-signed or expired certificate (evidence). If none works, stop and tell the user what is missing." >&2; exit 1 ;;
  esac
  mkdir -p ~/.claude/pr-steps
  echo "approach $(realpath "$out") $(date -u +%FT%TZ)" >> ~/.claude/pr-steps/approach."$key"
  echo "recorded approach for branch $(git symbolic-ref --short -q HEAD || echo HEAD)"
  exit 0
fi
# A refactor record is the pass's lists (the ✅ coverage list and old ⇒ new ratings), or a small follow-up that carries an
# earlier pass ("carries the pass of <sha>", ≤ 80 changed lines since): a fix log or a note is not a refactor pass
# A pass rates every item afresh: a row whose rating is copied ("10 =", "=", "unchanged since") is a re-rating of a delta, not a pass
is_pass() { grep -q '✅' "$1" && grep -Eq '[0-9]+ *(⇒|=>) *([0-9]+|removed|new|n/a)' "$1" && ! grep -Eiq '\| *([0-9]+ *)?= *\||unchanged since' "$1"; }
# A small follow-up (≤ 80 changed lines, no new behavior) carries an earlier head's recorded step: "carries the pass of <sha>"
carries() {
  c=$(grep -Eo 'carries the pass of [0-9a-f]{7,40}' "$out" | head -n1 | awk '{print $NF}'); [ -n "$c" ] || return 1
  full=$(git rev-parse "$c" 2>/dev/null) || { echo "$c is not a commit" >&2; exit 1; }
  awk -v s="$step" '$1==s' ~/.claude/pr-steps/"$full" 2>/dev/null | grep -q . || { echo "$c has no recorded $step to carry" >&2; exit 1; }
  changed=$(git diff --numstat "$full" HEAD | awk '{s+=$1+$2} END{print s+0}')
  [ "$changed" -le 80 ] || { echo "$changed lines changed since $c: too much to carry, run the $step step again (converge, per push)" >&2; exit 1; }
}
if [ "$step" != refactor ] && [ "$step" != gates ] && carries; then :; else
case "$step" in
  verify|reverify)
    [ "$last" = "NO BUGS" ] || [ "$step" = reverify -a "$last" = "NO LOOP B COMMITS" ] || { echo "$out does not end with a line NO BUGS: Loop A is done only when every slice has a dry pass after its last fix" >&2; exit 1; } ;;
  loopb)
    [ "$last" = CLEAN ] || { echo "$out does not end with a line CLEAN: fix its findings and continue the same agent" >&2; exit 1; } ;;
  fresh)
    grep -qx 'MERGE AS IS: yes' "$out" || { echo "$out has no line 'MERGE AS IS: yes': the fresh reader, as this repo's maintainer, would not merge it exactly as it is; what it lists stands between the PR and a yes" >&2; exit 1; }
    [ "$last" = CLEAN ] || { echo "$out does not end with a line CLEAN: fix its findings and continue the same agent" >&2; exit 1; } ;;
  refactor)
    if ! is_pass "$out"; then
      carried=$(grep -Eo 'carries the pass of [0-9a-f]{7,40}' "$out" | head -n1 | awk '{print $NF}')
      [ -n "$carried" ] || { echo "$out is not a refactor pass: it needs the ✅ coverage list and old ⇒ new ratings (mergeworthy refactor), or 'carries the pass of <sha>' for a small follow-up" >&2; exit 1; }
      full=$(git rev-parse "$carried")
      prev=$(awk '$1=="refactor"{print $2}' ~/.claude/pr-steps/"$full" 2>/dev/null | while read -r f; do is_pass "$f" && echo "$f"; done | head -n1)
      [ -n "$prev" ] || { echo "$carried has no recorded refactor pass with ratings to carry" >&2; exit 1; }
      changed=$(git diff --numstat "$full" HEAD | awk '{s+=$1+$2} END{print s+0}')
      [ "$changed" -le 80 ] || { echo "$changed lines changed since $carried: the pass is stale (mergeworthy refactor), run it again" >&2; exit 1; }
    fi ;;
  gates)
    grep -Eq '^.+ -> exit [0-9]+$' "$out" || { echo "$out lists no gate: one line per gate, '<command> -> exit <code>', run on this HEAD" >&2; exit 1; }
    ! grep -Eq ' -> exit [1-9][0-9]*$' "$out" || { echo "$out has a red gate: fix it on this HEAD first" >&2; exit 1; } ;;
esac
fi
grep -qsF " $(realpath "$out") " ~/.claude/pr-steps/"$sha" && { echo "$out is already recorded for $sha: each step has its own output" >&2; exit 1; }
mkdir -p ~/.claude/pr-steps
echo "$step $(realpath "$out") $(date -u +%FT%TZ)" >> ~/.claude/pr-steps/$sha
echo "recorded $step for $sha"
