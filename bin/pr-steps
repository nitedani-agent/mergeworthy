#!/usr/bin/env bash
# pr-steps <step> <output-file>: records that a converge step ran on the current HEAD, after checking its output proves it.
# Steps, in pipeline order (mergeworthy:converge): verify (Loop A), shape (Loop B: the review and the shape pass),
# reverify (Loop A after Loop B's commits), fresh (the fresh reader), gates (every gate's exit code on the final head).
# The posting hook blocks `gh pr create` (unless --draft), `gh pr ready` and pushes to a ready PR until HEAD has all five.
set -euo pipefail
step=${1:?usage: pr-steps <preflight|approach|verify|shape|reverify|fresh|gates> <output-file>}; out=${2:?output file}
case "$step" in preflight|approach|verify|shape|loopb|refactor|reverify|fresh|gates) ;; review) step=fresh ;;
  *) echo "step must be preflight, approach, verify, shape, reverify, fresh or gates" >&2; exit 1;; esac
# preflight and approach: one record per repo and branch; the hooks compute the same key
key=$(printf '%s\n%s' "$(realpath "$(git rev-parse --git-common-dir)")" "$(git symbolic-ref --short -q HEAD || echo HEAD)" | sha256sum | cut -c1-40)
mkdir -p ~/.claude/pr-steps
# A branch whose latest approach record has no `contract: 2` field was started by a session on v1's skills (before the shape
# pass and the maintainer's fresh read): it finishes under that contract (loopb and refactor, a fresh report without a Maintainer line).
old_pipeline() { [ -s ~/.claude/pr-steps/approach."$key" ] && ! tail -n1 ~/.claude/pr-steps/approach."$key" | grep -q ' contract: 2$'; }
case "$step" in loopb|refactor) old_pipeline || { echo "pr-steps shape replaces loopb and refactor: record Loop B's shape report (mergeworthy:converge step 2). Only a branch whose approach a session on v1's skills recorded (no contract: 2) still records them." >&2; exit 1; };; esac
# pr-steps preflight <app URL> [Chrome flags] | <PNG the session's browser MCP took just now> | 'none, because <why>':
# before any code, the app runs and browser control loads it (pull-request, Check you can finish before you start)
if [ "$step" = preflight ]; then
  shift; proof=~/.claude/pr-steps/preflight."$key".png
  case "$out" in
    "none, because "?*) proof=$out ;;
    http://*|https://*)
      shift; chrome=${CHROME:-$(command -v google-chrome chromium chromium-browser | head -n1 || true)}
      [ -n "$chrome" ] || { echo "no Chrome on PATH: screenshot the app with the session's browser MCP, then pr-steps preflight <that PNG>" >&2; exit 1; }
      profile=$(mktemp -d); trap 'rm -rf "$profile"' EXIT
      unset PULSE_SERVER  # WSLg hands its audio server to Chrome: the page would play on the user's speakers
      flags=(--headless=new --mute-audio --user-data-dir="$profile" --ignore-certificate-errors --window-size=1440,900 --virtual-time-budget=15000 "$@")
      timeout 120 "$chrome" "${flags[@]}" --dump-dom "$out" 2>/dev/null | python3 -c 'import re, sys; d = sys.stdin.read()
sys.exit("main-frame-error" in d or not re.sub(r"<[^>]*>|\s", "", re.sub(r"(?is)<(script|style)\b.*?</\1>", "", d)))' ||
        { echo "$out showed Chrome's error page or a blank page: start the app (and pass the Chrome flags its host needs), then retry" >&2; exit 1; }
      rm -f "$proof"; timeout 120 "$chrome" "${flags[@]}" --screenshot="$proof" "$out" >/dev/null 2>&1 || { echo "Chrome could not screenshot $out" >&2; exit 1; } ;;
    /*) [ -n "$(find "$out" -mmin -10 2>/dev/null)" ] || { echo "$out is not a screenshot taken in the last 10 minutes" >&2; exit 1; }
        proof=$out ;;
    *) echo "usage: pr-steps preflight <app URL> [Chrome flags], or <absolute path of a PNG the session's browser MCP just took of the app>, or 'none, because <why there is no UI or browser-run code>'" >&2; exit 1 ;;
  esac
  case "$proof" in none,*) ;; *) [ "$(head -c8 "$proof" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 89504e470d0a1a0a ] || { echo "$proof is not a PNG" >&2; exit 1; } ;; esac
  echo "preflight $proof $(date -u +%FT%TZ)" >> ~/.claude/pr-steps/preflight."$key"
  echo "recorded preflight for branch $(git symbolic-ref --short -q HEAD || echo HEAD): $proof"
  exit 0
fi
[ -s "$out" ] || { echo "$out is empty: run the step and save its output" >&2; exit 1; }
last=$(grep -v '^[[:space:]]*$' "$out" | tail -n1 || true)
sha=$(git rev-parse HEAD)
if [ "$step" = approach ]; then
  chosen=$(sed -n 's/^[[:space:]]*Chosen:[[:space:]]*//p' "$out" | head -n1 | sed 's/[[:space:]]*$//')
  [ -n "$chosen" ] || { echo "$out has no line 'Chosen: <candidate>'" >&2; exit 1; }
  # candidates: table rows `| name | rating 0-10 | why |`; the header and separator rows have no numeric rating
  rows=$(awk -F'|' '/^[[:space:]]*\|/ { for (i=1;i<=NF;i++) gsub(/^[[:space:]]+|[[:space:]]+$/,"",$i); if ($3 ~ /^([0-9]|10)(\/10)?$/ && $2 != "" && $4 != "") { sub(/\/10$/,"",$3); print tolower($2) "\t" $3 } }' "$out")
  [ "$(printf '%s' "$rows" | grep -c .)" -ge 2 ] || { echo "$out lists fewer than two rated candidates: a table '| Candidate | Rating | Why |' with each candidate, not building it included, rated 0-10 with its reason" >&2; exit 1; }
  rating=$(printf '%s\n' "$rows" | awk -F'\t' -v c="$(printf '%s' "$chosen" | tr 'A-Z' 'a-z')" '$1==c {print $2; exit}')
  [ -n "$rating" ] || { echo "Chosen '$chosen' is not a row of the candidates table" >&2; exit 1; }
  [ "$rating" -ge 7 ] || { echo "the chosen approach is rated $rating: 6 or below is not ready to build (pull-request step 5); find a better candidate or stop" >&2; exit 1; }
  # the contract is the one this session's loaded skills follow (session-start's record): a session on v1's catalog, or one
  # with no record, still records loopb and refactor, so its branch gets no `contract: 2`
  catalog=$(cut -d' ' -f2 ~/.mergeworthy/sessions/"$(basename "${CLAUDE_CODE_SESSION_ID:-none}")" 2>/dev/null || true)
  echo "approach $(realpath "$out") $(date -u +%FT%TZ)$([ "$catalog" = graph ] && echo ' contract: 2')" >> ~/.claude/pr-steps/approach."$key"
  echo "recorded approach for branch $(git symbolic-ref --short -q HEAD || echo HEAD)"
  exit 0
fi
# A shape record is the pass's lists (the ✅ coverage list and old ⇒ new ratings) ending CLEAN, or a small follow-up that
# carries an earlier pass ("carries the pass of <sha>", ≤ 80 changed lines since): a fix log or a note is not a shape pass
# A pass rates every item afresh: a row whose rating is copied ("10 =", "=", "unchanged since") is a re-rating of a delta, not a pass
is_pass() { grep -q '✅' "$1" && grep -Eq '[0-9]+ *(⇒|=>) *([0-9]+|removed|new|n/a)' "$1" && ! grep -Eiq '\| *([0-9]+ *)?= *\||unchanged since' "$1"; }
# A small follow-up (≤ 80 changed lines, no new behavior) carries an earlier head's recorded step: "carries the pass of <sha>"
carries() {
  c=$(grep -Eo 'carries the pass of [0-9a-f]{7,40}' "$out" | head -n1 | awk '{print $NF}' || true); [ -n "$c" ] || return 1
  full=$(git rev-parse "$c" 2>/dev/null) || { echo "$c is not a commit" >&2; exit 1; }
  awk -v s="$step" '$1==s' ~/.claude/pr-steps/"$full" 2>/dev/null | grep -q . || { echo "$c has no recorded $step to carry" >&2; exit 1; }
  changed=$(git diff --numstat "$full" HEAD | awk '{s+=$1+$2} END{print s+0}')
  [ "$changed" -le 80 ] || { echo "$changed lines changed since $c: too much to carry, run the $step step again (converge, per push)" >&2; exit 1; }
}
if [ "$step" != shape ] && [ "$step" != refactor ] && [ "$step" != gates ] && carries; then :; else
case "$step" in
  verify|reverify)
    [ "$last" = "NO BUGS" ] || [ "$step" = reverify -a "$last" = "NO LOOP B COMMITS" ] || { echo "$out does not end with a line NO BUGS: Loop A is done only when every slice has a dry pass after its last fix" >&2; exit 1; } ;;
  loopb)
    [ "$last" = CLEAN ] || { echo "$out does not end with a line CLEAN: fix its findings and continue the same agent" >&2; exit 1; } ;;
  fresh)
    grep -Eq '^Maintainer: @?[A-Za-z0-9-]+' "$out" || old_pipeline || { echo "$out has no line 'Maintainer: <login>': the fresh reader reviews as the maintainer who decides, citing what they said or did (mergeworthy delegate/fresh-reader.md)" >&2; exit 1; }
    grep -qx 'MERGE AS IS: yes' "$out" || { echo "$out has no line 'MERGE AS IS: yes': the fresh reader, as this repo's maintainer, would not merge it exactly as it is; what it lists stands between the PR and a yes" >&2; exit 1; }
    [ "$last" = CLEAN ] || { echo "$out does not end with a line CLEAN: fix its findings and continue the same agent" >&2; exit 1; } ;;
  shape|refactor)
    if is_pass "$out"; then
      [ "$step" = refactor ] ||
      [ "$last" = CLEAN ] || { echo "$out does not end with a line CLEAN: land what its review and shape pass found worth changing, then continue the same agent (mergeworthy:converge step 2)" >&2; exit 1; }
    else
      carried=$(grep -Eo 'carries the pass of [0-9a-f]{7,40}' "$out" | head -n1 | awk '{print $NF}' || true)
      copied=$(grep -Eio '\| *([0-9]+ *)?= *\||unchanged since' "$out" | head -n1 || true)
      [ -n "$carried" ] || [ -z "$copied" ] || { echo "$out is not a shape pass: a row's rating is copied ('$copied'); rate every file and function afresh as old ⇒ new, with the reason in your own words (mergeworthy delegate/shape.md)" >&2; exit 1; }
      [ -n "$carried" ] || { echo "$out is not a shape pass: it needs the ✅ coverage list and old ⇒ new ratings (mergeworthy delegate/shape.md), or 'carries the pass of <sha>' for a small follow-up" >&2; exit 1; }
      full=$(git rev-parse "$carried")
      rec=~/.claude/pr-steps/"$full"
      prev=$(awk -v s="$step" '$1=="shape"||$1==s{print $2}' "$rec" 2>/dev/null | while read -r f; do is_pass "$f" && echo "$f"; done | head -n1)
      # an old head's refactor pass stands for a shape pass only with its Loop B review: a loopb record ending CLEAN
      if [ -z "$prev" ] && [ "$step" = shape ]; then
        prev=$(awk '$1=="loopb"{print $2}' "$rec" 2>/dev/null | while read -r f; do [ "$(grep -v '^[[:space:]]*$' "$f" 2>/dev/null | tail -n1)" = CLEAN ] && echo "$f"; done | head -n1)
        [ -n "$prev" ] && prev=$(awk '$1=="refactor"{print $2}' "$rec" | while read -r f; do is_pass "$f" && echo "$f"; done | head -n1)
      fi
      [ -n "$prev" ] || { echo "$carried has no recorded shape pass with ratings to carry" >&2; exit 1; }
      changed=$(git diff --numstat "$full" HEAD | awk '{s+=$1+$2} END{print s+0}')
      [ "$changed" -le 80 ] || { echo "$changed lines changed since $carried: the pass is stale (mergeworthy:converge §Batching), run it again" >&2; exit 1; }
    fi ;;
  gates)
    grep -Eq '^.+ -> exit [0-9]+$' "$out" || { echo "$out lists no gate: one line per gate, '<command> -> exit <code>', run on this HEAD" >&2; exit 1; }
    ! grep -Eq ' -> exit [1-9][0-9]*$' "$out" || { echo "$out has a red gate: fix it on this HEAD first" >&2; exit 1; } ;;
esac
fi
grep -qsF " $(realpath "$out") " ~/.claude/pr-steps/"$sha" && { echo "$out is already recorded for $sha: each step has its own output" >&2; exit 1; }
mkdir -p ~/.claude/pr-steps
echo "$step $(realpath "$out") $(date -u +%FT%TZ)" >> ~/.claude/pr-steps/$sha
echo "recorded $step for $sha"
