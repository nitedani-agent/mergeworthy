#!/usr/bin/env python3
"""disk-sweep [--delete]: with --delete, deletes the build folders and node_modules under the work folders (~/*-work/) and
~/.t3/worktrees/ that hold nothing a rebuild can't restore, and prunes Docker's dangling images and build cache. Before each
deletion it appends `<UTC time, YYYY-MM-DDTHH:MM:SSZ> <bytes> <path, or docker:image or docker:builder> <rule> deleting` to
~/.mergeworthy/disk-sweep.log, and the same line ending `deleted` or `failed` after it. <bytes> is the allocated size of the
entries whose every hard link is inside the path; a Docker prune writes one line, `deleted`, with the size Docker reports once it
succeeded. Without --delete it prints those lines without the last word, `?` for Docker's bytes, and deletes nothing.
It never follows a symlink or leaves a root's filesystem, deletes nothing with a symlink on its path, and runs one at a time.
"Idle": no file outside the paths git ignores has an mtime within 24 hours of the sweep's start. "Busy": a process works in the
folder or holds a file open in it, or an unfinished job in ~/.claude/agent-jobs names its absolute or ~/ path, read each time.
A candidate is kept when it holds version-control data, a file with an mtime in the last 24 hours or a folder the sweep can't
read, or when its repo or loose parent is busy right before it would be listed or deleted.
- c-ignored: in an idle repo or worktree that isn't busy, the folders git ignores named in BUILD.
- c-node_modules: outside any repo in a work folder, a node_modules whose parent is idle (node_modules and nested repos aside)
  and isn't busy.
- h-ignored, once a day: the same folders in any git repo up to 5 levels below HOME (hidden folders and the work folders
  aside), each untouched for 14 days.
- k-cache, once a day: `pnpm store prune`, `pip cache purge`, `npm cache clean --force` when ~/.npm/_cacache is untouched for
  14 days, and each entry of the named tool caches (CACHES: cargo's, and ~/.cache/yarn, node-gyp, playwright and the like) untouched for 14 days, not busy.
- d-docker: `docker image prune -a` (every unused image) and `docker builder prune`, with `-f --filter until=336h`, each by its
  own age rule; never containers or volumes.
Weekly, ~/.mergeworthy/disk-report.md lists the 20 largest folders under HOME untouched for 14 days that no rule deletes.
Deleting under the account's home and pruning Docker happen only when the watcher daemon of the main watch dir started the sweep
(from_daemon); anything else deletes only in folders outside that home, a test's temp roots."""
import datetime, fcntl, glob, os, pwd, re, shutil, subprocess, sys, time
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'hooks'))
import agent_jobs

if not os.path.isdir('/proc/self'):
    sys.exit('disk-sweep: needs /proc to see which processes work where')
DRY = True
HOME, NOW = os.path.expanduser('~'), time.time()
DAY = 86400
OLD = 14 * DAY  # the round-7 rules: untouched for 14 days
VCS = {'.git', '.hg', '.svn', '.jj'}  # a checkout's commits and edits, which no build restores
BUILD = {'node_modules', 'dist', 'build', '.next', '.vite', '.turbo', '.svelte-kit', 'coverage', 'test-results', 'playwright-report'}  # never .cache: projects keep dumps and reports there
STATE = os.path.join(HOME, '.mergeworthy')
ACCOUNT_HOME = os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir)  # from the password database: a probe's HOME can't move it
INSTALLED = os.path.realpath(os.path.join(ACCOUNT_HOME, '.mergeworthy', 'current'))


def inside(path, top):
    return path == top or path.startswith(top + '/')


def main_watch_dir():
    """The account's main watch dir, as the watcher's main_dir() picks it: ~/.mergeworthy/main-watch while its watcher runs,
    else the first live dir in ~/.claude/gh-watch-dirs.txt."""
    def live(d):
        try:
            os.kill(int(open(os.path.join(d, 'gh-watch.pid')).read().strip()), 0)
            return True
        except (OSError, ValueError):
            return False
    try:
        dirs = [open(os.path.join(ACCOUNT_HOME, '.mergeworthy', 'main-watch')).read().strip()]
    except OSError:
        dirs = []
    try:
        dirs += [l.strip() for l in open(os.path.join(ACCOUNT_HOME, '.claude', 'gh-watch-dirs.txt'))]
    except OSError:
        pass
    return next((os.path.realpath(d) for d in dirs if d and live(d)), None)


def from_daemon(installed, main):
    """Whether the watcher daemon of the watch dir main, running from installed, started this process: this file is inside
    installed, its parent runs installed's gh-watch.py with main as its working dir, and main's gh-watch.pid names the
    parent's parent, the daemon's loop. A test, a probe or an imported main() has another parent, another copy or no pid file."""
    if not main or not inside(os.path.realpath(__file__), installed):
        return False
    ppid = os.getppid()
    try:
        here = os.readlink(f'/proc/{ppid}/cwd')
        argv = open(f'/proc/{ppid}/cmdline', 'rb').read().decode(errors='replace').split('\0')
        loop = int(open(f'/proc/{ppid}/stat').read().rsplit(')', 1)[1].split()[1])
        pid = int(open(os.path.join(here, 'gh-watch.pid')).read().strip())
    except (OSError, ValueError, IndexError):
        return False
    script = next((a for a in argv if os.path.basename(a) == 'gh-watch.py'), None)
    return bool(script) and inside(os.path.realpath(os.path.join(here, script)), installed) and here == main and pid == loop


def record(nbytes, what, rule, state):
    line = f"{datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {nbytes} {what} {rule}"
    if DRY:
        print(line, flush=True)
    else:
        with open(os.path.join(STATE, 'disk-sweep.log'), 'a') as f:
            f.write(f'{line} {state}\n')


def git(repo, *args):
    return subprocess.run(['git', '--no-optional-locks', '-C', repo, *args], capture_output=True, text=True)


def mention(path):
    """A regex for path, or a path inside it, as a job's text writes it: absolute or from ~/."""
    forms = [path] + (['~' + path[len(HOME):]] if path.startswith(HOME + '/') else [])
    return '(?:' + '|'.join(map(re.escape, forms)) + r')(?![\w-]|\.[\w.-])'  # a sentence's full stop may follow it


def measure(path, dev, age=DAY, vcs=True):
    """The bytes deleting path frees (st_blocks * 512 of each entry whose every hard link is inside), or None when it must stay: it holds an
    entry on another filesystem, version-control data (VCS), a file changed in the last 24 hours, or a folder it can't read."""
    st = os.lstat(path)
    if st.st_dev != dev:
        return None
    inodes, stack = {st.st_ino: [1 if os.path.isdir(path) else st.st_nlink, 1, st.st_blocks * 512]}, [path]
    while stack:
        try:
            entries = list(os.scandir(stack.pop()))
        except OSError:
            return None
        for e in entries:
            st = e.stat(follow_symlinks=False)
            d = e.is_dir(follow_symlinks=False)
            if st.st_dev != dev or vcs and e.name in VCS or not d and st.st_mtime > NOW - age:
                return None
            inodes.setdefault(st.st_ino, [1 if d else st.st_nlink, 0, st.st_blocks * 512])[1] += 1
            if d:
                stack.append(e.path)
    return sum(blocks for links, seen, blocks in inodes.values() if seen >= links)


def changed(top, skip, age=DAY):
    """Whether a file under top, outside the paths skip(path relative to top) excludes, has an mtime within age of the start."""
    stack = [top]
    while stack:
        try:
            entries = list(os.scandir(stack.pop()))
        except OSError:
            continue
        for e in entries:
            if skip(os.path.relpath(e.path, top)):
                continue
            if e.is_dir(follow_symlinks=False):
                stack.append(e.path)
            elif e.stat(follow_symlinks=False).st_mtime > NOW - age:
                return True
    return False


def in_use(path):
    """A process has its cwd or an open file inside path, read from /proc now (the kernel's link targets hold no symlinks)."""
    for pid in filter(str.isdigit, os.listdir('/proc')):
        if int(pid) == os.getpid():
            continue
        links = [f'/proc/{pid}/cwd']
        try:
            links += [f'/proc/{pid}/fd/{fd}' for fd in os.listdir(f'/proc/{pid}/fd')]
        except OSError:
            pass
        for link in links:
            try:
                target = os.readlink(link)
            except OSError:
                continue
            if (target + '/').startswith(path + '/'):
                return True
    return False


_daemon = {}


def authorized(path=None):
    """Raise PermissionError unless this process may delete path now, or run a Docker command (path None): never in a dry run,
    and under the account's home or for Docker only when the main watch dir's daemon started it (from_daemon, worked out once
    per parent process). Every function that deletes or runs Docker calls it right before the syscall or the exec."""
    if DRY:
        raise PermissionError('disk-sweep: a dry run deletes nothing and runs no Docker command')
    if path is None or inside(path, ACCOUNT_HOME):
        if os.getppid() not in _daemon:
            _daemon[os.getppid()] = from_daemon(INSTALLED, main_watch_dir())
        if not _daemon[os.getppid()]:
            raise PermissionError(f'disk-sweep: only the watcher daemon of the main watch dir deletes under {ACCOUNT_HOME} or runs Docker')


def open_dir(path):
    """An fd of the directory path, opened from / one component at a time; OSError when a component is a symlink."""
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
    for name in path.strip('/').split('/'):
        try:
            sub = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
        finally:
            os.close(fd)
        fd = sub
    return fd


def empty(fd, path=None):
    """Delete everything inside the open directory fd (path, for authorized), opening each subdirectory without following a symlink."""
    path = path or os.readlink(f'/proc/self/fd/{fd}')
    for e in os.scandir(fd):
        if e.is_dir(follow_symlinks=False):
            sub = os.open(e.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            try:
                empty(sub, os.path.join(path, e.name))
            finally:
                os.close(sub)
            authorized(os.path.join(path, e.name))
            os.rmdir(e.name, dir_fd=fd)
        else:
            authorized(os.path.join(path, e.name))
            os.unlink(e.name, dir_fd=fd)


def remove(path, st):
    """Delete the directory path through fds opened without following a symlink, only while it is still the inode st."""
    parent = open_dir(os.path.dirname(path))
    try:
        fd = os.open(os.path.basename(path), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
        try:
            if (os.fstat(fd).st_dev, os.fstat(fd).st_ino) != (st.st_dev, st.st_ino):
                raise OSError(f'{path} is no longer the directory the sweep inspected')
            empty(fd, path)
        finally:
            os.close(fd)
        authorized(path)
        os.rmdir(os.path.basename(path), dir_fd=parent)
    finally:
        os.close(parent)


_jobs = [None, []]


def jobs_text():
    """The key, brief and ticket files of each unfinished agent job, read again whenever the job folder's listing changes."""
    try:
        listing = sorted((f, os.stat(os.path.join(agent_jobs.JOBS, f)).st_mtime_ns) for f in os.listdir(agent_jobs.JOBS))
    except OSError:
        listing = []
    if listing != _jobs[0]:
        _jobs[0], _jobs[1] = listing, []
        for _, j in agent_jobs.jobs():
            if not agent_jobs.finished(j):
                tickets = [p for p in j['key'].split() if p.startswith('/') and os.path.isfile(p)]
                _jobs[1].append('\n'.join([j['key'], j.get('brief', '')] + [open(t, errors='replace').read() for t in tickets]))
    return _jobs[1]


def busy(path):
    """A process works in path or holds a file open inside it, or an unfinished agent job names it or a path inside it."""
    rx = re.compile(mention(path))
    return in_use(path) or any(rx.search(t) for t in jobs_text())


def delete(path, owner, dev, rule, age=DAY, vcs=True):
    """Delete path, a candidate inside owner (its repo, or a loose node_modules' parent), unless it or owner must stay."""
    st = os.lstat(path)
    if os.path.realpath(path) != path:
        return
    nbytes = measure(path, dev, age, vcs)
    if nbytes is None:
        return
    if busy(owner):  # a process or a job may have started in owner since its selection
        return
    if not DRY:
        record(nbytes, path, rule, 'deleting')
        try:
            remove(path, st)
        except OSError as e:
            print(f'disk-sweep: {path}: {e}', file=sys.stderr)
            record(nbytes, path, rule, 'failed')
            return
    record(nbytes, path, rule, 'deleted')


def walk(root, work):
    """(root's device, the repos under root, and when work is true the node_modules folders outside them), on root's filesystem."""
    dev, repos, loose, stack = os.lstat(root).st_dev, [], [], [root]
    while stack:
        d = stack.pop()
        if os.path.lexists(os.path.join(d, '.git')):
            repos.append(d)
            continue
        try:
            entries = list(os.scandir(d))
        except OSError:
            continue
        for e in entries:
            st = e.stat(follow_symlinks=False)
            if e.is_symlink() or st.st_dev != dev:
                continue
            if e.is_dir() and e.name != 'node_modules':
                stack.append(e.path)
            elif e.is_dir() and work:
                loose.append(e.path)
    return dev, repos, loose


def sweep_files():
    roots = [(r.rstrip('/'), True) for r in sorted(glob.glob(os.path.join(HOME, '*-work/')))]
    roots.append((os.path.join(HOME, '.t3', 'worktrees'), False))
    for root, work in roots:
        if os.path.islink(root) or not os.path.isdir(root):
            continue
        dev, repos, loose = walk(root, work)
        for repo in repos:
            sweep_repo(repo, dev, 'c-ignored', DAY)
        for nm in loose:
            parent = os.path.dirname(nm)
            if not busy(parent) and not changed(parent, lambda rel: os.path.basename(rel) == 'node_modules' or os.path.lexists(os.path.join(parent, rel, '.git'))):
                delete(nm, parent, dev, 'c-node_modules')


def sweep_repo(repo, dev, rule, age):
    """In an idle repo that isn't busy, the folders git ignores named in BUILD, each untouched for age."""
    listed = git(repo, 'ls-files', '-z', '-o', '-i', '--exclude-standard', '--directory')
    ignored = {p.rstrip('/') for p in listed.stdout.split('\0') if p}
    if listed.returncode or busy(repo) or changed(repo, lambda rel: rel == '.git' or rel in ignored):
        return
    for rel in ignored:
        p = os.path.join(repo, rel)
        if os.path.basename(p) in BUILD and os.path.isdir(p) and not os.path.islink(p):
            delete(p, repo, dev, rule, age)


def due(name, period):
    """Whether the step name last ran more than period seconds ago, stamping it now if so; a dry run always runs it, unstamped."""
    if DRY:
        return True
    stamp = os.path.join(STATE, f'disk-sweep.{name}')
    try:
        if NOW - os.path.getmtime(stamp) < period:
            return False
    except OSError:
        pass
    open(stamp, 'a').close()
    os.utime(stamp, (NOW, NOW))
    return True


def sweep_home():
    """Once a day, h-ignored: build output untouched for 14 days in the git repos up to 5 levels below HOME, outside hidden
    folders and the work folders (sweep_files has those)."""
    if not due('home', DAY):
        return
    dev, stack = os.lstat(HOME).st_dev, [(HOME, 0)]
    while stack:
        d, depth = stack.pop()
        if d != HOME and os.path.lexists(os.path.join(d, '.git')):
            sweep_repo(d, dev, 'h-ignored', OLD)
            continue
        if depth == 5:
            continue
        try:
            entries = list(os.scandir(d))
        except OSError:
            continue
        for e in entries:
            if e.name.startswith('.') or e.name in BUILD or d == HOME and e.name.endswith('-work'):
                continue
            if e.is_dir(follow_symlinks=False) and e.stat(follow_symlinks=False).st_dev == dev:
                stack.append((e.path, depth + 1))


CACHES = ('.cargo/registry/cache', '.cargo/git/checkouts', '.cache/node-gyp', '.cache/typescript', '.cache/yarn', '.cache/go-build',
          '.cache/puppeteer', '.cache/ms-playwright', '.cache/electron', '.cache/pre-commit')  # named tool caches only (other ~/.cache folders can hold drafts and records); each entry inside goes after 14 untouched days


def run_tool(*argv):
    """A package manager's own cache command, logged as k-cache tool:<name>; a missing tool is skipped. authorized() first."""
    if not shutil.which(argv[0]):
        return
    if not DRY:
        authorized(HOME)
        r = subprocess.run(argv, capture_output=True, text=True)
        if r.returncode:
            print(f'disk-sweep: {" ".join(argv)} exited {r.returncode}: {r.stderr.strip()}', file=sys.stderr)
            return
    record('?', f'tool:{argv[0]}', 'k-cache', 'deleted')


def sweep_caches():
    """Once a day, k-cache: pnpm's and pip's own cache commands, npm's when ~/.npm/_cacache is untouched for 14 days, and each
    entry of CACHES untouched for 14 days that isn't busy (a cargo git checkout may hold .git: cargo rebuilds it from its db)."""
    if not due('caches', DAY):
        return
    try:
        run_tool('pnpm', 'store', 'prune')
        cacache = os.path.join(HOME, '.npm', '_cacache')
        if os.path.isdir(cacache) and not changed(cacache, lambda rel: False, OLD):
            run_tool('npm', 'cache', 'clean', '--force')
        run_tool('pip', 'cache', 'purge')
    except PermissionError as e:
        print(f'{e}: package caches skipped', file=sys.stderr)
    for rel in CACHES:
        top = os.path.join(HOME, rel)
        if os.path.islink(top) or not os.path.isdir(top):
            continue
        dev = os.lstat(top).st_dev
        for e in sorted(os.scandir(top), key=lambda e: e.name):
            if e.is_dir(follow_symlinks=False):
                delete(e.path, e.path, dev, 'k-cache', OLD, vcs=rel != '.cargo/git/checkouts')


def report():
    """Weekly, never a deletion: ~/.mergeworthy/disk-report.md lists the 20 largest folders under HOME with no file changed in
    14 days that no rule deletes (build folders, CACHES and ~/.npm/_cacache left out), for the user to pick from."""
    if not due('report', 7 * DAY):
        return
    skip, dev, found = {os.path.join(HOME, c) for c in CACHES + ('.npm/_cacache',)}, os.lstat(HOME).st_dev, []

    def walk_size(d):
        """(bytes, newest mtime) of d without the skipped folders; adds each stale folder whose parent isn't stale to found."""
        total, newest, stale = 0, 0, []
        try:
            entries = list(os.scandir(d))
        except OSError:
            return 0, NOW
        for e in entries:
            st = e.stat(follow_symlinks=False)
            if st.st_dev != dev or e.path in skip or e.name in BUILD:
                continue
            if e.is_dir(follow_symlinks=False):
                b, n = walk_size(e.path)
                if n < NOW - OLD:
                    stale.append((b, e.path))
            else:
                b, n = st.st_blocks * 512, st.st_mtime
            total, newest = total + b, max(newest, n)
        if newest >= NOW - OLD or d == HOME:
            found.extend(stale)
        return total, newest

    walk_size(HOME)
    rows = [f'| {b / 1e9:.2f} GB | {p} |' for b, p in sorted(found, reverse=True)[:20]]
    with open(os.path.join(STATE, 'disk-report.md'), 'w') as f:
        f.write('# Folders under the home folder untouched for 14 days that no disk-sweep rule deletes\n\n| Size | Folder |\n|---|---|\n'
                + '\n'.join(rows) + '\n')


PRUNES = (('image', '-a'), ('builder',))  # no containers: until= selects one created long ago even if it stopped a minute ago


def prune_docker():
    """d-docker; 1 when a prune fails, else 0. A dry run lists the prunes without calling Docker; a deleting run prunes only
    when the watcher daemon of the main watch dir started it, since the machine's Docker is shared with every test and probe."""
    if not shutil.which('docker'):
        return 0
    if DRY:
        for what, *_ in PRUNES:
            record('?', f'docker:{what}', 'd-docker', 'deleted')
        return 0
    try:
        if run_docker('version', timeout=60).returncode:
            return 0
    except PermissionError as e:
        print(f'{e}: Docker skipped', file=sys.stderr)
        return 0
    except subprocess.TimeoutExpired:
        return 0
    failed = 0
    for what, *every in PRUNES:
        r = run_docker(what, 'prune', *every, '-f', '--filter', 'until=336h')
        if r.returncode:
            print(f'disk-sweep: docker {what} prune exited {r.returncode}: {r.stderr.strip()}', file=sys.stderr)
            failed = 1
            continue
        m = re.search(r'Total(?: reclaimed space)?:\s*([\d.]+)\s*([kKMGT]?)B', r.stdout)
        record(int(float(m[1]) * 1000 ** ' KMGT'.index(m[2].upper() or ' ')) if m else 0, f'docker:{what}', 'd-docker', 'deleted')
    return failed


def run_docker(*args, timeout=None):
    """docker <args>, captured, once authorized() allows a Docker command."""
    authorized()
    return subprocess.run(['docker', *args], capture_output=True, text=True, timeout=timeout)


def main():
    global DRY
    if sys.argv[1:] not in ([], ['--delete']):
        sys.exit('usage: disk-sweep [--delete]')
    DRY = sys.argv[1:] != ['--delete']
    home = os.path.realpath(HOME)
    if not DRY and (inside(home, ACCOUNT_HOME) or inside(ACCOUNT_HOME, home)) and not from_daemon(INSTALLED, main_watch_dir()):
        print(f'disk-sweep: --delete under {ACCOUNT_HOME} runs only from the watcher daemon of the main watch dir', file=sys.stderr)
        sys.exit(2)
    os.makedirs(STATE, exist_ok=True)
    lock = open(os.path.join(STATE, 'disk-sweep.lock'), 'a')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit('disk-sweep: another sweep is running')
    sweep_files()
    sweep_home()
    sweep_caches()
    report()
    sys.exit(prune_docker())


if __name__ == '__main__':
    main()
