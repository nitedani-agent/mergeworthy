#!/usr/bin/env python3
"""disk-sweep [--delete]: with --delete, deletes what can be rebuilt or is finished, under the work folders (~/*-work/), ~/.t3/worktrees/
and Docker, and appends one line per deletion (`<iso time> <bytes> <path or docker object> <rule>`) to
~/.mergeworthy/disk-sweep.log; without it, a dry run prints those lines and deletes nothing. It never follows a symlink or leaves a
root's filesystem, and runs one at a time. "Idle" is no file changed in 24 hours, folders git ignores excluded.
- a-worktree: a work folder's git worktree, clean (untracked files count), its HEAD on a remote branch, idle, no process
  working in it, no open agent job naming it, no transcript of the last 24 hours naming it: `git worktree remove`; the branch stays.
- ~/.t3/worktrees: T3 Code binds its threads to these worktrees, so none is removed; only c applies there.
- c-ignored: in an idle repo or worktree with no process or open agent job in it, the folders git ignores named in BUILD.
- c-node_modules: outside any repo in a work folder, node_modules whose parent is idle, with no process or open agent job in it.
- d-docker: stopped containers, dangling images and build cache older than 24 hours; never volumes. Its bytes are what
  Docker reports, `?` in a dry run.
- e-old-file: outside any repo in a work folder, *.webm, *.mp4, *.zip and *.log files over 10 MB unchanged for 7 days."""
import datetime, fcntl, glob, mmap, os, re, shutil, subprocess, sys, time
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'hooks'))
import agent_jobs

if sys.argv[1:] not in ([], ['--delete']):
    sys.exit('usage: disk-sweep [--delete]')
if not os.path.isdir('/proc/self'):
    sys.exit('disk-sweep: needs /proc to see which processes work where')
DRY = sys.argv[1:] != ['--delete']
HOME, NOW = os.path.expanduser('~'), time.time()
DAY, WEEK, BIG = 86400, 7 * 86400, 10 * 2**20
BUILD = {'node_modules', 'dist', 'build', '.next', '.vite', '.turbo', '.svelte-kit', 'coverage', 'test-results', 'playwright-report', '.cache'}
OLD = ('.webm', '.mp4', '.zip', '.log')
STATE = os.path.join(HOME, '.mergeworthy')
os.makedirs(STATE, exist_ok=True)
lock = open(os.path.join(STATE, 'disk-sweep.lock'), 'a')
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit('disk-sweep: another sweep is running')


def record(nbytes, what, rule):
    line = f"{datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {nbytes} {what} {rule}"
    if DRY:
        print(line, flush=True)
    else:
        with open(os.path.join(STATE, 'disk-sweep.log'), 'a') as f:
            f.write(line + '\n')


def git(repo, *args):
    return subprocess.run(['git', '--no-optional-locks', '-C', repo, *args], capture_output=True, text=True)


def mention(path):
    """A regex for path, or a path inside it, as a brief or a transcript writes it: absolute or from ~."""
    forms = [path] + (['~' + path[len(HOME):]] if path.startswith(HOME + '/') else [])
    return '(?:' + '|'.join(map(re.escape, forms)) + r')(?![\w.-])'


def reclaim(path, dev):
    """The bytes deleting path frees (an inode counts once every link to it is inside), or None when it reaches another filesystem."""
    st = os.lstat(path)
    if st.st_dev != dev:
        return None
    inodes, stack = {st.st_ino: [1 if os.path.isdir(path) else st.st_nlink, 1, st.st_blocks * 512]}, [path]
    while stack:
        try:
            entries = list(os.scandir(stack.pop()))
        except OSError:
            continue
        for e in entries:
            st = e.stat(follow_symlinks=False)
            if st.st_dev != dev:
                return None
            d = e.is_dir(follow_symlinks=False)
            inodes.setdefault(st.st_ino, [1 if d else st.st_nlink, 0, st.st_blocks * 512])[1] += 1
            if d:
                stack.append(e.path)
    return sum(blocks for links, seen, blocks in inodes.values() if seen >= links)


def changed(top, skip):
    """Whether a file under top, outside the paths skip(path relative to top) excludes, changed in the last 24 hours."""
    stack = [top]
    while stack:
        try:
            entries = list(os.scandir(stack.pop()))
        except OSError:
            continue
        for e in entries:
            if skip(os.path.relpath(e.path, top)):
                continue
            if e.is_dir(follow_symlinks=False):
                stack.append(e.path)
            elif e.stat(follow_symlinks=False).st_mtime > NOW - DAY:
                return True
    return False


def delete(path, dev, rule):
    nbytes = reclaim(path, dev)
    if nbytes is None:
        return
    if not DRY:
        try:
            if os.path.isdir(path) and not os.path.islink(path):
                shutil.rmtree(path)
            else:
                os.remove(path)
        except OSError as e:
            print(f'disk-sweep: {path}: {e}', file=sys.stderr)
            return
    record(nbytes, path, rule)


CWDS = []
for pid in filter(str.isdigit, os.listdir('/proc')):
    try:
        if int(pid) != os.getpid():
            CWDS.append(os.readlink(f'/proc/{pid}/cwd'))
    except OSError:
        pass
JOBS = []
for _, j in agent_jobs.jobs():
    if not agent_jobs.finished(j):
        tickets = [p for p in j['key'].split() if p.startswith('/') and os.path.isfile(p)]
        JOBS.append('\n'.join([j['key'], j.get('brief', '')] + [open(t, errors='replace').read() for t in tickets]))


def busy(path):
    """A process works in path, or an open agent job names it or a path inside it."""
    rx = re.compile(mention(path))
    return any(c == path or c.startswith(path + '/') for c in CWDS) or any(rx.search(t) for t in JOBS)


def in_transcripts(paths):
    """The paths a Claude Code transcript written in the last 24 hours names."""
    rx, found = {p: re.compile(mention(p).encode()) for p in paths}, set()
    root = os.path.join(HOME, '.claude', 'projects')
    for t in glob.glob(f'{root}/*/*.jsonl') + glob.glob(f'{root}/*/*/subagents/*.jsonl'):
        try:
            if os.path.getmtime(t) < NOW - DAY or not os.path.getsize(t):
                continue
            with open(t, 'rb') as f, mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as m:
                found |= {p for p in paths if p not in found and rx[p].search(m)}
        except OSError:
            pass
    return found


def walk(root, work):
    """root's filesystem, the repos under it and the node_modules folders outside them; e-old-file for a work folder's files outside repos."""
    dev, repos, loose, stack = os.lstat(root).st_dev, [], [], [root]
    while stack:
        d = stack.pop()
        if os.path.lexists(os.path.join(d, '.git')):
            repos.append(d)
            continue
        try:
            entries = list(os.scandir(d))
        except OSError:
            continue
        for e in entries:
            st = e.stat(follow_symlinks=False)
            if e.is_symlink() or st.st_dev != dev:
                continue
            if e.is_dir() and e.name != 'node_modules':
                stack.append(e.path)
            elif e.is_dir() and work:
                loose.append(e.path)
            elif work and e.is_file() and e.name.endswith(OLD) and st.st_size > BIG and st.st_mtime < NOW - WEEK:
                delete(e.path, dev, 'e-old-file')
    return dev, repos, loose


def ignored_build(repo, ignored, dev):
    for rel in ignored:
        p = os.path.join(repo, rel)
        if os.path.basename(p) in BUILD and os.path.isdir(p) and not os.path.islink(p):
            delete(p, dev, 'c-ignored')


def remove_worktree(path, dev):
    nbytes = reclaim(path, dev)
    common = git(path, 'rev-parse', '--path-format=absolute', '--git-common-dir').stdout.strip()
    if nbytes is None or not common:
        return
    if not DRY:
        r = subprocess.run(['git', '--git-dir', common, 'worktree', 'remove', path], capture_output=True, text=True)
        if r.returncode:
            print(f'disk-sweep: {path}: {r.stderr.strip()}', file=sys.stderr)
            return
        subprocess.run(['git', '--git-dir', common, 'worktree', 'prune'], capture_output=True)
    record(nbytes, path, 'a-worktree')


roots = [(r.rstrip('/'), True) for r in sorted(glob.glob(os.path.join(HOME, '*-work/')))]
roots.append((os.path.join(HOME, '.t3', 'worktrees'), False))
pending = []  # work folders' worktrees that pass every check of rule a but the transcripts'
for root, work in roots:
    if os.path.islink(root) or not os.path.isdir(root):
        continue
    dev, repos, loose = walk(root, work)
    for repo in repos:
        listed = git(repo, 'ls-files', '-z', '-o', '-i', '--exclude-standard', '--directory')
        ignored = {p.rstrip('/') for p in listed.stdout.split('\0') if p}
        if listed.returncode or busy(repo) or changed(repo, lambda rel: rel == '.git' or rel in ignored):
            continue
        if work and os.path.isfile(os.path.join(repo, '.git')) and not git(repo, 'status', '--porcelain', '--untracked-files=normal').stdout \
                and git(repo, 'branch', '-r', '--contains', 'HEAD').stdout.strip():
            pending.append((repo, ignored, dev))
        else:
            ignored_build(repo, ignored, dev)
    for nm in loose:
        parent = os.path.dirname(nm)
        if not busy(parent) and not changed(parent, lambda rel: os.path.basename(rel) == 'node_modules' or os.path.lexists(os.path.join(parent, rel, '.git'))):
            delete(nm, dev, 'c-node_modules')
named = in_transcripts([p for p, _, _ in pending])
for repo, ignored, dev in pending:
    if repo in named:
        ignored_build(repo, ignored, dev)
    else:
        remove_worktree(repo, dev)

def docker_answers():
    try:
        return bool(shutil.which('docker')) and not subprocess.run(['docker', 'version'], capture_output=True, timeout=60).returncode
    except subprocess.TimeoutExpired:
        return False


if docker_answers():
    for what in ('container', 'image', 'builder'):
        if DRY:
            record('?', f'docker:{what}', 'd-docker')
            continue
        out = subprocess.run(['docker', what, 'prune', '-f', '--filter', 'until=24h'], capture_output=True, text=True).stdout
        m = re.search(r'Total(?: reclaimed space)?:\s*([\d.]+)\s*([kKMGT]?)B', out)
        record(int(float(m[1]) * 1000 ** ' KMGT'.index(m[2].upper() or ' ')) if m else 0, f'docker:{what}', 'd-docker')
