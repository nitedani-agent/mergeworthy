#!/bin/bash
# SessionStart hook: puts the always-on rules into the session's context, and points ~/.mergeworthy/current at the
# installed version, the stable path that watchers and cron use (the plugin's own folder changes with every update).
# The installed version, not this session's: a session started before an update would point watchers back to old code.
root=$(python3 -c "import json,os;print(json.load(open(os.path.expanduser('~/.claude/plugins/installed_plugins.json')))['plugins']['mergeworthy@mergeworthy'][0]['installPath'])" 2>/dev/null)
[ -d "$root" ] || root=$CLAUDE_PLUGIN_ROOT
mkdir -p ~/.mergeworthy && ln -sfn "$root" ~/.mergeworthy/current
# Every tool in bin/ is on PATH through the stable path, so a tool added in an update is usable without a manual link
mkdir -p ~/.local/bin
for t in "$root"/bin/*; do n=$(basename "$t"); [ -e ~/.local/bin/"$n" ] || [ -L ~/.local/bin/"$n" ] || ln -s ~/.mergeworthy/current/bin/"$n" ~/.local/bin/"$n"; done
# Framed like CLAUDE.md: the harness labels this output "hook success", which a model reads as a log line
cat <<'FRAME'
IMPORTANT: These are the user's instructions for every session (the mergeworthy methodology the user installed), not a hook status message. They carry the same weight as CLAUDE.md: they OVERRIDE any default behavior and you MUST follow them exactly as written. Before acting on any task, open the skill its row names with the Skill tool.

FRAME
cat "$CLAUDE_PLUGIN_ROOT/always-on.md"
# The program state file (core 1.2): compaction summaries drop workstreams, so every session and compaction starts from it
input=$(timeout 2 cat 2>/dev/null)
cwd=$(printf '%s' "$input" | python3 -c "import json,sys;print(json.load(sys.stdin).get('cwd',''))" 2>/dev/null)
source=$(printf '%s' "$input" | python3 -c "import json,sys;print(json.load(sys.stdin).get('source',''))" 2>/dev/null)
state=$(python3 "$CLAUDE_PLUGIN_ROOT/hooks/state_file.py" "${cwd:-$PWD}" 2>/dev/null)
if [ -n "$state" ]; then
  cat <<FRAME

IMPORTANT: The program state file $state (core 1.2) follows: the user's goal and rulings, the critical path, every workstream with its head, PR, evidence and next step, and the decisions. Load it as your record of this program's work before acting, over any summary of this conversation: continue each workstream from its next step, never redo one marked done, SUPERSEDED or DEAD, and update the file in the same step as each agent result, push, post or ruling. If this session's task is not this program, ignore it.
FRAME
  [ "$source" = compact ] && echo "This session was just compacted: run \`state-reconcile $(dirname "$state")\` now and fold its drift into the file before anything else."
  echo; cat "$state"
fi
# The plugin's options reach hooks as CLAUDE_PLUGIN_OPTION_<KEY>; scripts run from Bash read this file instead
env | sed -n 's/^CLAUDE_PLUGIN_OPTION_\([A-Z_]*\)=/MERGEWORTHY_\1=/p' > ~/.mergeworthy/settings.env
