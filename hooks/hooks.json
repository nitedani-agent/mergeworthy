{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run session-memory.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Agent|Task|Write|Edit|MultiEdit|NotebookEdit|mcp__.*(delegate_task|t3_thread_launch|create_threads))$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run pre-skill-gate.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run pre-bash-guard.py"
          }
        ]
      },
      {
        "matcher": "^(Agent|Task|mcp__.*(delegate_task|t3_thread_launch))$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run pre-agent-dedupe.py"
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|mcp__.*delegate_task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run pre-design-gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|Task|mcp__.*delegate_task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run pre-agent-dedupe.py register"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run post-bash-register.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/run stop-lint.py"
          }
        ]
      }
    ]
  }
}
