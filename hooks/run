#!/bin/bash
# Runs hook script $1. An installed copy runs it from ~/.mergeworthy/current, the installed version, so an update reaches
# sessions already running (only a change to hooks.json needs a restart); a checkout (claude --plugin-dir) runs its own.
# A block (exit 2) is logged once a day per hook and message start in ~/.mergeworthy/hooks-fired.log, the evidence
# `steward fired` reads for which checks still catch something.
d=$(dirname "$0")
case "$d" in */plugins/cache/*) [ -f "$HOME/.mergeworthy/current/hooks/$1" ] && d=$HOME/.mergeworthy/current/hooks;; esac
s=$1; shift
err=$(mktemp 2>/dev/null) || exec python3 "$d/$s" "$@"
python3 "$d/$s" "$@" 2>"$err"; rc=$?
cat "$err" >&2
if [ "$rc" = 2 ]; then
  l="$(date -u +%F) $s $(head -1 "$err" | tr -s '[:space:]' ' ' | cut -d' ' -f1-8)"
  log="$HOME/.mergeworthy/hooks-fired.log"
  { grep -qxF "$l" "$log" || echo "$l" >> "$log"; } 2>/dev/null  # no ~/.mergeworthy: nothing logged, the message unchanged
fi
rm -f "$err"
exit "$rc"
